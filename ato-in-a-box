                                <td className="px-6 py-4 whitespace-nowrap text-sm text-cyan-300">{log.action}</td>
                                <td className="px-6 py-4 text-sm text-gray-300">{log.detail}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
);


  // --- 6. RENDER LAYOUT ---

  return (
    <div className="min-h-screen p-4 md:p-8 bg-gray-900 text-white font-sans antialiased">
      <style>{`
        .cyber-button {
            transition: all 0.2s;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.5), 0 0 20px rgba(0, 255, 255, 0.2);
            text-shadow: 0 0 5px rgba(0, 255, 255, 0.8);
        }
        .cyber-button:hover {
            box-shadow: 0 0 15px rgba(0, 255, 255, 0.8), 0 0 30px rgba(0, 255, 255, 0.5);
        }
        .progress-bar {
            background: linear-gradient(to right, #00ffff, #008080);
        }
      `}</style>

      <header className="mb-8 border-b border-gray-700 pb-4">
        <div className="flex justify-between items-center">
          <h1 className="text-3xl font-bold text-cyan-400 tracking-wider">
            ATO-in-a-Box | <span className="text-white">RMF Automation Platform</span>
          </h1>
          
          {/* Role-Based Access Control (RBAC) Simulation */}
          <div className="flex items-center space-x-3 test-sm">
            <label className="text-gray-400">Current Role:</label>
            <select
              value={currentRole}
              onChange={(e) => setCurrentRole(e.target.value)}
              className={`p-2 rounded-md border border-gray-600 ${currentRoleConfig.color} focus:ring-cyan-500 focus:border-cyan-500`}
            >
              {Object.entries(ROLES).map(([key, role]) => (
                <option key={key} value={key}>{role.name} ({key})</option>
              ))}
            </select>
            <span className="text-sm font-medium text-white px-2 py-1 rounded-md bg-gray-700 border border-cyan-500/50">
                {currentRoleConfig.permissions.join(', ').toUpperCase()}
            </span>
            <span className={`text-sm font-medium px-2 py-1 rounded-md border ${atoStatus.includes('Approved') ? 'border-green-500 text-green-400' : atoStatus.includes('Denied') ? 'border-red-500 text-red-400' : 'border-yellow-500 text-yellow-400'} bg-gray-700/50`}>
                ATO: {atoStatus}
            </span>
          </div>
        </div>
      </header>
      
      {/* Messaging Area */}
      {message && (
        <div className={`p-4 rounded-lg mb-6 ${message.type === 'error' ? 'bg-red-900/50 text-red-300 border-red-500' : message.type === 'success' ? 'bg-green-900/50 text-green-300 border-green-500' : 'bg-blue-900/50 text-blue-300 border-blue-500'} border`} role="alert">
          {message.text}
        </div>
      )}

      {/* Tabs Navigation */}
      <div className="border-b border-gray-700 mb-6 flex space-x-4">
        <TabButton id="dashboard" label="RMF Dashboard" />
        <TabButton id="controls" label="Control Review (NIST 800-53)" />
        <TabButton id="poam" label="POA&M Automation" />
        <TabButton id="risk" label="Risk Register" />
        <TabButton id="audit" label="Audit Trail" />
        {currentRole === 'AO' && <TabButton id="authorization" label="Final Authorization" />}
      </div>

      <div className="space-y-8">
        {/* --- DASHBOARD VIEW (Default for ISSM/ISSO) --- */}
        {activeTab === 'dashboard' && (
          <div>
            <h2 className="text-2xl font-semibold mb-6 text-white border-l-4 border-cyan-400 pl-3">ATO Readiness Scorecard </h2>
            <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
              <MetricCard title="Compliance Score" value={complianceScore} unit="%" className="col-span-2 md:col-span-1" />
              <MetricCard title="ATO Readiness" value={readinessLevel} className={`col-span-2 md:col-span-1 ${readinessLevel === 'High' ? 'bg-green-900/50' : readinessLevel === 'Moderate' ? 'bg-yellow-900/50' : 'bg-red-900/50'}`} />
              <MetricCard title="Unaddressed Controls" value={controls.filter(c => c.status === 'Not Implemented').length} className="col-span-2 md:col-span-1" />
              <MetricCard title="Risk Posture" value={riskPosture} className={`col-span-2 md:col-span-1 ${riskPosture.includes('High') ? 'bg-red-900/50' : riskPosture.includes('Moderate') ? 'bg-yellow-900/50' : 'bg-green-900/50'}`} />

              <div className="md:col-span-4 p-6 rounded-xl shadow-xl bg-white/10 border border-gray-700/50">
                  <h3 className="text-xl font-semibold mb-4 text-cyan-400">Compliance Heat Map (Simulated)</h3>
                  <p className="text-lg mb-2">Controls Implemented: <span className="font-bold text-green-400">{implemented}</span> / <span className="font-bold">{total}</span></p>
                  <div className="h-4 w-full bg-gray-700 rounded-full overflow-hidden">
                      <div 
                          className="h-full progress-bar" 
                          style={{ width: `${complianceScore}%` }}
                      ></div>
                  </div>
                  <p className="mt-4 text-sm text-gray-400">
                    *Compliance Score factors in Partially Implemented controls (50% credit). Next milestone: 85% for High Readiness.
                  </p>
              </div>

              {/* CCM Trigger for ISSM/ISSO */}
              <div className="md:col-span-4 p-6 rounded-xl shadow-xl bg-gray-800 border border-cyan-500/50">
                  <h3 className="text-xl font-semibold mb-3 text-cyan-400">Continuous Control Monitoring (CCM)</h3>
                  <p className='text-sm text-gray-400 mb-4'>
                    Trigger the real-time scan (simulating integration with SIEM/Configuration Management tools) to check live status of technical controls (e.g., CM-6, IR-4, AU-6).
                  </p>
                  <button
                      onClick={runContinuousMonitoring}
                      disabled={isProcessing || !currentRoleConfig.permissions.includes('view_all')}
                      className="cyber-button px-6 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold disabled:bg-gray-600 disabled:shadow-none"
                  >
                      {isProcessing ? 'Running Live Scan...' : 'Run Continuous Monitoring Check'}
                  </button>
              </div>

            </div>
          </div>
        )}

        {/* --- CONTROL REVIEW VIEW --- */}
        {activeTab === 'controls' && (
          <div>
            <h2 className="text-2xl font-semibold mb-6 text-white border-l-4 border-cyan-400 pl-3">NIST SP 800-53 Rev. 5 Control Inventory</h2>
            
            {/* Manual Control Selector and Editor */}
            <div className="p-4 bg-gray-800 rounded-xl border border-gray-700 mb-4">
                <h3 className="text-lg font-semibold text-white mb-3">Manual Control Review / Status Update</h3>
                <div className="flex items-center space-x-3">
                    <label htmlFor="control-selector" className="text-gray-400 font-medium whitespace-nowrap">Select Control:</label>
                    <select
                        id="control-selector"
                        value={selectedControlId}
                        onChange={(e) => setSelectedControlId(e.target.value)}
                        className="p-2 w-full max-w-sm rounded-md bg-gray-900 border border-gray-600 text-white focus:ring-cyan-500 focus:border-cyan-500"
                    >
                        <option value="">-- Select a Control ID --</option>
                        {controls.map(c => (
                            <option key={c.id} value={c.id}>
                                {c.id} - {c.title}
                            </option>
                        ))}
                    </select>
                </div>
                <div className='mt-4'>
                    <ManualControlEditor />
                </div>
            </div>

            {/* Hierarchical Tree View */}
            <ControlFamilyAccordion />

            {/* AI/NLP Ingestion Panel */}
            <div className='mt-8 p-6 rounded-xl bg-gray-800 border border-cyan-500/50 shadow-2xl'>
                <h3 className='text-xl font-semibold mb-3 text-cyan-400'>Automated Documentation Analysis (AI/NLP Engine)</h3>
                <p className='text-sm text-gray-400 mb-4'>
                    **OCR Prerequisite:** Upload your large PDF/Image policy file below. The system would first perform **Optical Character Recognition (OCR)** to extract all 100+ pages of text, which is then fed into the NLP engine.
                </p>
                
                {/* Simulated File Upload Input */}
                <div className='flex items-center space-x-4 mb-4'>
                    <label htmlFor="file-upload" className="cyber-button cursor-pointer px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm disabled:bg-gray-600 disabled:shadow-none">
                        {fileName ? `Change File (${fileName})` : 'Upload Policy File (PDF/Image)'}
                    </label>
                    <input
                        id="file-upload"
                        type="file"
                        className="hidden"
                        onChange={handleFileChange}
                        disabled={isProcessing || !currentRoleConfig.permissions.includes('update_evidence')}
                    />
                     {fileName && (
                        <p className="text-sm text-gray-300 truncate max-w-xs">{fileName} ready for text paste.</p>
                    )}
                </div>

                <textarea
                    className="w-full h-32 p-3 text-sm rounded-lg bg-gray-900 border border-gray-600 text-gray-200 focus:ring-cyan-500 focus:border-cyan-500"
                    placeholder={`Paste the OCR-extracted text here (e.g., policy statements, narrative descriptions):\n\nExample Text to test multiple controls:\n"The organization employs a Zero Trust Architecture (AC-3) and requires periodic review of user permissions (AC-6). All media is destroyed or wiped according to NSS Manual 4009 (MP-6), and we maintain a formal Supply Chain Risk Management (SA-12) program." `}
                    value={documentContent}
                    onChange={(e) => setDocumentContent(e.target.value)}
                    disabled={isProcessing || !currentRoleConfig.permissions.includes('update_evidence')}
                />

                <div className="flex justify-between items-center mt-4">
                  <button
                      onClick={handleDocumentUpload}
                      disabled={isProcessing || !currentRoleConfig.permissions.includes('update_evidence')}
                      className="cyber-button px-6 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white font-bold disabled:bg-gray-600 disabled:shadow-none"
                  >
                      {isProcessing ? 'Analyzing Evidence...' : 'Analyze & Auto-Populate Controls'}
                  </button>
                  {!currentRoleConfig.permissions.includes('update_evidence') && (
                      <p className='text-red-400 text-sm'>Access Denied: Only ISSM/System Owner can submit evidence.</p>
                  )}
                </div>
            </div>
          </div>
        )}

        {/* --- POA&M AUTOMATION VIEW --- */}
        {activeTab === 'poam' && (
          <div>
            <h2 className="text-2xl font-semibold mb-6 text-white border-l-4 border-cyan-400 pl-3">Plan of Action & Milestones (POA&M) Automation</h2>
            
            <div className='flex items-center justify-between p-4 bg-gray-800 rounded-t-xl border-b border-gray-700'>
              <p className='text-gray-300 font-medium'>Total Deficiencies Logged: <span className='text-cyan-400 font-bold'>{poamList.length}</span></p>
              <button
                  onClick={generatePOAandM}
                  disabled={!currentRoleConfig.permissions.includes('edit_controls')}
                  className="cyber-button px-6 py-2 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold text-sm disabled:bg-gray-600 disabled:shadow-none"
              >
                  Generate New POA&M Entries
              </button>
            </div>

            <div className="bg-gray-800 rounded-b-xl shadow-2xl overflow-hidden border border-gray-700">
                <div className="overflow-x-auto">
                    <table className="min-w-full divide-y divide-gray-700">
                        <thead className="bg-gray-700">
                            <tr>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">ID / Control</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Finding</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Severity</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Remediation Action</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Responsible Party</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Due Date</th>
                                <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                        <tbody className="divide-y divide-gray-700">
                            {poamList.length === 0 && (
                                <tr>
                                    <td colSpan="7" className="px-6 py-8 text-center text-gray-500">
                                        No Open POA&M findings. Click "Generate New POA&M Entries" to check current control status.
                                    </td>
                                </tr>
                            )}
                            {poamList.map((poam) => (
                                <tr key={poam.id} className="hover:bg-gray-700 transition-colors duration-150">
                                    <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-red-400">{poam.controlId}</td>
                                    <td className="px-6 py-4 text-sm text-gray-300">{poam.finding}</td>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm font-semibold text-red-500">{poam.severity}</td>
                                    <td className="px-6 py-4 text-sm text-gray-400 max-w-xs">{poam.remediation}</td>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm text-cyan-300">{poam.responsibleParty}</td>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-300">{poam.dueDate}</td>
                                    <td className="px-6 py-4 whitespace-nowrap text-sm text-yellow-300">{poam.status}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div className='mt-8 p-6 rounded-xl bg-gray-800 border border-gray-600 shadow-2xl'>
                <h3 className='text-xl font-semibold mb-3 text-white'>Export & Integration APIs </h3>
                <p className='text-sm text-gray-400 mb-4'>Finalize the ATO package for external ingestion into systems like eMASS or Xacta, and reporting.</p>
                
                {/* NEW: eMASS Exports */}
                <div className='border-t border-b border-gray-700 py-4 mb-4'>
                    <h4 className='text-lg font-medium text-cyan-400 mb-3'>eMASS CSV Data Ingestion Files</h4>
                    <p className='text-sm text-gray-400 mb-4'>
                        Generates the two primary CSV files required for eMASS import: Controls (SSP) and POA&M.
                    </p>
                    <div className='flex flex-wrap gap-4'>
                        <button
                            onClick={exportControlsToEmassCsv}
                            disabled={!currentRoleConfig.permissions.includes('edit_controls')}
                            className="cyber-button px-6 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold disabled:bg-gray-600"
                        >
                            Export **Security Controls** CSV
                        </button>
                        <button
                            onClick={exportPoamToEmassCsv}
                            disabled={!currentRoleConfig.permissions.includes('edit_controls')}
                            className="cyber-button px-6 py-2 rounded-lg bg-green-600 hover:bg-green-500 text-white font-bold disabled:bg-gray-600"
                        >
                            Export **POA&M** CSV
                        </button>
                    </div>
                </div>

                {/* Existing: ATO Package Export */}
                <div className='mt-4'>
                    <h4 className='text-lg font-medium text-cyan-400 mb-3'>Final ATO Package Export (OSCAL/FedRAMP)</h4>
                    <div className='flex space-x-4'>
                        <button
                            onClick={() => handleExport('OSCAL_eMASS')}
                            className="cyber-button px-6 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-bold disabled:bg-gray-600"
                        >
                            Export OSCAL / Xacta Package (.json)
                        </button>
                        <button
                            onClick={() => handleExport('FedRAMP_Template')}
                            className="cyber-button px-6 py-2 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold disabled:bg-gray-600"
                        >
                            Generate FedRAMP Word/Excel Report
                        </button>
                    </div>
                </div>
            </div>
          </div>
        )}

        {/* --- RISK REGISTER VIEW --- */}
        {activeTab === 'risk' && <RiskRegisterView />}

        {/* --- AUDIT TRAIL VIEW --- */}
        {activeTab === 'audit' && <AuditTrailView />}
        
        {/* --- FINAL AUTHORIZATION VIEW (AO only) --- */}
        {activeTab === 'authorization' && <AuthorizationView />}
      </div>
    </div>
  );
};

export default App;
