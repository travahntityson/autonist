    const newLogEntry = {
        timestamp: new Date().toLocaleString(),
        user: `${currentRole}: Manual Action`,
        role: currentRole,
        action: 'ATO Package Export',
        detail: `Exported full ATO package in ${format} format (OSCAL compliant).`,
