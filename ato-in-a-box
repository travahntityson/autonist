import React, { useState, useEffect, useCallback, useMemo } from 'react';
// Import the dynamic data generation function from the separate file
import { createFullControlCatalog, CONTROL_FAMILIES_CODES } from './nist_control_data.js';

// --- 1. MOCK DATA & CONFIGURATION ---

// Defining the roles for RBAC simulation
const ROLES = {
  AO: { name: 'Authorization Official', color: 'bg-red-500/20 text-red-600 border-red-500', permissions: ['view_all', 'authorize'] },
  ISSM: { name: 'ISSM / Auditor', color: 'bg-blue-500/20 text-blue-600 border-blue-500', permissions: ['view_all', 'edit_controls', 'approve_poam', 'update_evidence'] },
  SO: { name: 'System Owner', color: 'bg-green-500/20 text-green-600 border-green-500', permissions: ['view_controls', 'update_evidence'] },
};

// All 20 NIST Control Families (NIST SP 800-53 Rev. 5 Core Set)
const CONTROL_FAMILIES = {
    'AC': 'Access Control', 'AT': 'Awareness and Training', 'AU': 'Audit and Accountability',
    'CA': 'Security Assessment and Authorization', 'CM': 'Configuration Management', 'CP': 'Contingency Planning',
    'IA': 'Identification and Authentication', 'IR': 'Incident Response', 'MA': 'Maintenance',
    'MP': 'Media Protection', 'PE': 'Physical and Environmental Protection', 'PM': 'Program Management',
    'PS': 'Personnel Security', 'RA': 'Risk Assessment', 'SC': 'System and Communications Protection', 
    'SI': 'System and Information Integrity', 'SA': 'System and Services Acquisition', 'SR': 'Supply Chain Risk Management',
    'PL': 'Planning', 'PT': 'Privacy'
};

const CONTROL_STATUSES = ['Implemented', 'Partially Implemented', 'Not Implemented', 'Not Applicable'];

// --- 2. MAIN APPLICATION COMPONENT ---

const App = () => {
  // Dynamic initialization of controls and assessments from the generator function
  const { initialControls, initialAssessments } = useMemo(() => createFullControlCatalog(), []);

  const [controls, setControls] = useState(initialControls);
  const [poamList, setPoamList] = useState([]);
  const [riskRegister] = useState([]); // Risk Register will be populated by POA&M High findings
  const [auditLog, setAuditLog] = useState([
    { timestamp: new Date().toLocaleString(), user: 'System Init', role: 'System', action: 'Application Start', detail: `${initialControls.length} controls and ${initialAssessments.length} assessments loaded.` },
  ]); 
  const [currentRole, setCurrentRole] = useState('ISSM');
  const [activeTab, setActiveTab] = useState('controls'); // Default to controls tab
  const [fileName, setFileName] = useState(''); 
  const [isProcessing, setIsProcessing] = useState(false);
  const [message, setMessage] = useState('');
  const [atoStatus, setAtoStatus] = useState('Pending Authorization');
  const [selectedControlId, setSelectedControlId] = useState('');
  const [localNarrative, setLocalNarrative] = useState({}); // State to hold temporary edits for all controls
  const [openControlId, setOpenControlId] = useState(''); // State to track which single control editor is open
  const [assessments] = useState(initialAssessments); // Use initialAssessments

  const currentRoleConfig = ROLES[currentRole];

  // Sync manual narrative state with selected control's narrative
  useEffect(() => {
    const selectedControl = controls.find(c => c.id === openControlId);
    if (selectedControl) {
        setLocalNarrative(prev => ({ ...prev, [openControlId]: selectedControl.procedure }));
    } else {
        setLocalNarrative({});
    }
  }, [openControlId, controls]);


  // Helper function to calculate compliance metrics
  const { total, implemented, complianceScore, readinessLevel, riskPosture } = useMemo(() => {
    const total = controls.length;
    const implemented = controls.filter(c => c.status === 'Implemented').length;
    const partiallyImplemented = controls.filter(c => c.status === 'Partially Implemented').length;
    const notImplemented = controls.filter(c => c.status === 'Not Implemented').length;
    const na = controls.filter(c => c.status === 'Not Applicable').length;
    
    // Score calculation emphasizes full implementation
    const complianceScore = Math.round(((implemented + (partiallyImplemented * 0.5)) / (total - na)) * 100) || 0;
    
    let readinessLevel = 'Low';
    if (complianceScore > 85) readinessLevel = 'High';
    else if (complianceScore > 65) readinessLevel = 'Moderate';

    // Derive Risk Posture from high-severity open POA&Ms
    let riskPosture = 'Acceptable';
    const highSeverityPoams = poamList.filter(p => p.status === 'Open' && p.severity === 'High');
    
    if (highSeverityPoams.length > 5) {
        riskPosture = 'Very High Risk';
    } else if (highSeverityPoams.length > 0) {
        riskPosture = 'High Risk';
    } else if (notImplemented > 0) {
        riskPosture = 'Moderate Risk';
    }

    return { total, implemented, complianceScore, readinessLevel, riskPosture };
  }, [controls, poamList]);

  // Handle simulated file upload (extracting filename)
  const handleFileChange = (event) => {
    const file = event.target.files[0];
    if (file) {
      setFileName(file.name);
      setMessage({ type: 'info', text: `File "${file.name}" uploaded. Processing via simulated OCR. Click Analyze to run NLP.` });
    }
  };

  // --- CORE AUTOMATION FUNCTIONS ---

  // Simulates the LLM/NLP Document Analysis (Automated Documentation Analysis)
  const handleDocumentUpload = useCallback(() => {
    if (!fileName) {
      setMessage({ type: 'error', text: 'Please upload a policy file first.' });
      return;
    }
    // --- MOCK POLICY CONTENT (Simulating OCR Output) ---
    const mockPolicyContent = `
        Section 3.1: Access Control. The organization mandates annual security training for all personnel (AT-2) and uses LMS records to verify completion. 
        Access enforcement is handled by implementing a Zero Trust Architecture (AC-3) across the network boundary. 
        Furthermore, the least privilege principle (AC-6) is strictly followed via a mandatory quarterly review of user permissions.
        Section 5.2: Media Protection. All magnetic media is destroyed or wiped according to NSS Manual 4009 (MP-6) standards by the facilities manager.
        The overall Continuous Monitoring program (CA-7) uses automated tools to check for configuration baseline enforcement (CM-6) every 12 hours.
        The formal Supply Chain Risk Management (SA-12) plan requires vetting for all COTS components before acquisition.
    `;
    const policySentences = mockPolicyContent.split('.').map(s => s.trim()).filter(s => s.length > 1);
    
    // --- MOCK CCI CONTINGENCY DATA (Simulating structured scan results) ---
    const mockCciFindings = [
        { cci: 'CCI-000200', controlId: 'AC-3', status: 'Pass', artifact: 'NIST STIG Report' },
        { cci: 'CCI-000343', controlId: 'IR-5', status: 'Fail', artifact: 'ACAS Scan Report' }, // IR-5 will be marked Partially Implemented via CCI
        { cci: 'CCI-000180', controlId: 'SI-10', status: 'Pass', artifact: 'SAST Tool Report' }, // SI-10 will be marked Implemented via CCI
    ];
    const cciToControlMap = new Map(mockCciFindings.map(f => [f.controlId, f]));
    // --- END MOCK CCI CONTINGENCY DATA ---


    if (!currentRoleConfig.permissions.includes('update_evidence')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/System Owner can update evidence via this function.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'AI/NLP Engine performing targeted extraction on uploaded policy text...' });

    // Use a timeout to simulate API latency
    setTimeout(() => {
      const newControls = [...controls];
      let controlsUpdated = 0;
      const updatedControlIds = [];
      const timestamp = new Date().toLocaleDateString();
      const artifactBaseName = fileName;

      // 1. Map of Control IDs to their required keywords (Targeted RAG)
      const controlKeywords = {
          'AC-3': { keywords: ['zero trust architecture', 'access enforcement'], procedure: null, updatedBy: null },
          'AC-6': { keywords: ['least privilege principle', 'periodic review of user permissions'], procedure: null, updatedBy: null },
          'CM-6': { keywords: ['configuration baseline enforcement', 'automated tools to check for drift'], procedure: null, updatedBy: null },
          'AT-2': { keywords: ['annual security training', 'lms records'], procedure: null, updatedBy: null },
          'MP-6': { keywords: ['media is destroyed or wiped', 'nss manual 4009'], procedure: null, updatedBy: null },
          'SA-12': { keywords: ['supply chain risk management', 'vetting for all cots components'], procedure: null, updatedBy: null },
          'CA-7': { keywords: ['continuous monitoring program', 'iscm strategy'], procedure: null, updatedBy: null },
          'IR-5': { keywords: [], procedure: null, updatedBy: null }, // CCI only
          'SI-10': { keywords: [], procedure: null, updatedBy: null }, // CCI only
      };

      // 1. STAGE 1: Targeted Text Extraction (RAG)
      policySentences.forEach(sentence => {
          const lowerCaseSentence = sentence.toLowerCase();
          
          Object.keys(controlKeywords).forEach(controlId => {
              const controlConfig = controlKeywords[controlId];
              // Only attempt NLP if control is not yet addressed and has keywords
              if (!controlConfig.procedure && controlConfig.keywords.length > 0 && controlConfig.keywords.some(keyword => lowerCaseSentence.includes(keyword))) {
                  controlKeywords[controlId].procedure = sentence.trim() + '.';
                  controlKeywords[controlId].updatedBy = 'RAG Engine';
              }
          });
      });

      // 2. STAGE 2: CCI Contingency Check for remaining controls
      Object.keys(controlKeywords).forEach(controlId => {
          const controlConfig = controlKeywords[controlId];
          const cciFinding = cciToControlMap.get(controlId);
          
          // Check if RAG failed AND control has a CCI finding
          if (!controlConfig.updatedBy && cciFinding) {
              const status = cciFinding.status === 'Pass' ? 'Implemented' : 'Partially Implemented';
              const procedure = `CCI CONTINGENCY: Status auto-set to ${status} via technical finding ${cciFinding.cci}. Artifact: ${cciFinding.artifact}.`;

              controlKeywords[controlId].procedure = procedure;
              controlKeywords[controlId].updatedBy = `CCI Check (${cciFinding.cci})`;
          }
      });


      // 3. Update Control Status and Artifacts
      Object.keys(controlKeywords).forEach(controlId => {
          const updateSource = controlKeywords[controlId].updatedBy;
          
          if (updateSource) {
              const control = newControls.find(c => c.id === controlId);
              if (control) {
                  let status = control.status;
                  let procedure = controlKeywords[controlId].procedure;
                  let artifact = `${artifactBaseName} - ${updateSource}`;

                  if (updateSource.startsWith('CCI Check')) {
                      status = procedure.includes('Implemented') ? 'Implemented' : 'Partially Implemented';
                      artifact = `${cciToControlMap.get(controlId).artifact}`;
                      procedure = procedure.replace('CCI CONTINGENCY: ', ''); // Remove internal tag
                  } else {
                      status = 'Implemented';
                  }
                  
                  if (control.status !== status || !control.procedure.includes('Automated Engine')) {
                      control.status = status;
                      controlsUpdated++;
                  }
                  
                  // Update procedure and artifacts
                  control.procedure = procedure;
                  if (!control.artifacts.includes(artifact)) {
                     control.artifacts.push(artifact);
                  }

                  updatedControlIds.push(control.id);
              }
          }
      });
      
      setControls(newControls);

      // --- Audit Logging Logic ---
      if (controlsUpdated > 0) {
        const newLogEntry = {
          timestamp: new Date().toLocaleString(),
          user: `${currentRole}: Automated Engine`,
          role: currentRole,
          action: 'NLP/CCI Automated Check',
          detail: `${controlsUpdated} control status(es) updated: [${updatedControlIds.join(', ')}].`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]); 
      }
      
      setIsProcessing(false);
      setMessage({ 
          type: 'success', 
          text: `Automated Analysis Complete on "${artifactBaseName}". ${updatedControlIds.length} controls were updated via RAG/CCI: [${updatedControlIds.join(', ')}].` 
      });
    }, 2500);
  }, [controls, fileName, currentRole, currentRoleConfig.permissions]);

  // Simulates the Continuous Control Monitoring (CCM) Engine (NIST SP 800-137)
  const runContinuousMonitoring = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('view_all')) {
        setMessage({ type: 'error', text: 'Access Denied: Role must have view_all permission to run CCM.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'Initiating Continuous Monitoring Engine... Checking real-time status against authorized baseline.' });

    setTimeout(() => {
        const newControls = [...controls];
        let statusUpdates = 0;
        const timestamp = new Date().toLocaleString();

        // 1. CM-6: Configuration Settings Check (High-Value Check for Drift)
        const cm6 = newControls.find(c => c.id === 'CM-6');
        const driftDetected = Math.random() > 0.8; // 20% chance of drift failure
        
        if (cm6) {
          if (driftDetected) {
              if (cm6.status !== 'Partially Implemented') {
                  cm6.status = 'Partially Implemented';
                  cm6.artifacts.push(`CCM Alert: Baseline Drift Detected (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Baseline drift detected by monitoring agent. Manual inspection required.`;
              }
          } else {
              if (cm6.status !== 'Implemented') {
                  cm6.status = 'Implemented';
                  cm6.artifacts = cm6.artifacts.filter(a => !a.includes('CCM Alert')); 
                  cm6.artifacts.push(`CCM Report: Baseline Compliance Confirmed (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Configuration compliance confirmed by monitoring agent. No drift detected.`;
              }
          }
        }

        // 2. IR-4: Incident Handling (Testing for active SIEM/Ticketing integration)
        const ir4 = newControls.find(c => c.id === 'IR-4');
        const activeMonitoring = Math.random() > 0.1; // 90% chance of passing
        
        if (ir4) {
          if (activeMonitoring) {
              if (ir4.status !== 'Implemented') {
                  ir4.status = 'Implemented';
                  ir4.artifacts.push(`CCM Report: SIEM/Ticketing Integration Confirmed Active (${timestamp})`);
                  statusUpdates++;
                  ir4.procedure = `CCM UPDATE: Active monitoring and SIEM integration verified. Automated containment working.`;
              }
          } else {
              if (ir4.status !== 'Partially Implemented') {
                  ir4.status = 'Partially Implemented';
                  ir4.artifacts.push(`CCM Alert: SIEM Integration Failed/Inactive (${timestamp})`);
                  statusUpdates++;
                  ir4.procedure = `CCM UPDATE: SIEM feed connectivity test failed. Manual check required.`;
              }
          }
        }

        // 3. AU-6: Audit Review, Analysis, and Reporting check
        const au6 = newControls.find(c => c.id === 'AU-6');
        const reportingSuccess = Math.random() > 0.2; // 80% chance of success
        if (au6) {
          if (reportingSuccess) {
            if (au6.status !== 'Implemented') {
              au6.status = 'Implemented';
              au6.artifacts.push(`CCM Report: Daily Audit Report Generation Confirmed (${timestamp})`);
              statusUpdates++;
              au6.procedure = `CCM UPDATE: Daily audit report generation service is operational.`;
            }
          } else {
            if (au6.status !== 'Partially Implemented') {
              au6.status = 'Partially Implemented';
              au6.artifacts.push(`CCM Alert: Audit Report Failure/Delay Detected (${timestamp})`);
              statusUpdates++;
              au6.procedure = `CCM UPDATE: Daily audit report generation service failed. POA&M entry required.`;
            }
          }
        }
        
        setControls(newControls);

        // Audit Logging for CCM
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRole}: Automated Engine`,
            role: 'System',
            action: 'Continuous Monitoring Run',
            detail: `CCM completed. ${statusUpdates} control status changes detected.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]); 

        setIsProcessing(false);
        setMessage({ type: 'success', text: `CCM Run Complete: ${statusUpdates} control statuses updated based on real-time data feeds. Check Control Review for details.` });

    }, 3000); // Simulate 3 seconds for the comprehensive scan
  }, [controls, currentRole, currentRoleConfig.permissions]);


  // Simulates POA&M Automation (Generate Plan of Action & Milestones)
  const generatePOAandM = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can generate POA&M entries.' });
        return;
    }
    
    // Find all controls that are not fully implemented and are not currently in an 'Open' POA&M
    const deficiencies = controls.filter(c => 
        c.status !== 'Implemented' && 
        c.status !== 'Not Applicable' &&
        !poamList.some(p => p.controlId === c.id && p.status === 'Open')
    );
    
    if (deficiencies.length === 0) {
      setMessage({ type: 'info', text: 'No new deficiencies found. All current findings are either Implemented or already in the Open POA&M list.' });
      return;
    }

    const newPoamEntries = deficiencies.map(c => {
      // POA&M Automation Logic: Determine details based on control metadata
      let remediationSteps = `Investigate deficiency in ${c.title}.`;
      let dueDate = new Date();
      
      switch (c.severity) {
        case 'High':
          dueDate.setDate(dueDate.getDate() + 90); // 90 days for High
          remediationSteps = `HIGH PRIORITY: Implement system requirements for ${c.id} and document the fix for auditor review.`;
          break;
        case 'Moderate':
          dueDate.setDate(dueDate.getDate() + 180); // 180 days for Moderate
          break;
        default:
          dueDate.setDate(dueDate.getDate() + 365); // 365 days for Low
      }

      return {
        id: crypto.randomUUID(),
        controlId: c.id,
        finding: `${c.id} (${c.title}) is currently ${c.status}.`,
        severity: c.severity,
        remediation: remediationSteps,
        responsibleParty: c.family === 'AC' ? 'System Owner' : 'ISSM',
        dueDate: dueDate.toLocaleDateString(),
        status: 'Open',
        creationDate: new Date().toLocaleDateString(),
      };
    });
    
    setPoamList(prev => [...prev.filter(p => p.status === 'Open'), ...newPoamEntries]);
    
    // Log POA&M Generation action
    const newLogEntry = {
        timestamp: new Date().toLocaleString(),
        user: `${currentRole}: Manual Action`,
        role: currentRole,
        action: 'POA&M Generation',
        detail: `Generated new POA&M list. ${newPoamEntries.length} new deficiencies detected.`,
    };
    setAuditLog(prevLog => [newLogEntry, ...prevLog]);

    setMessage({ type: 'success', text: `POA&M generated successfully. ${newPoamEntries.length} new deficiencies detected and logged.` });
  }, [controls, poamList, currentRole, currentRoleConfig.permissions]);

  // Handle POA&M closure/mitigation
  const handlePoamClosure = useCallback((poamId, newStatus) => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can close POA&M entries.' });
        return;
    }

    let closedPoam;
    const newPoamList = poamList.map(p => {
        if (p.id === poamId) {
            closedPoam = p;
            return { ...p, status: newStatus, closureDate: new Date().toLocaleDateString() };
        }
        return p;
    });

    if (closedPoam) {
        setPoamList(newPoamList);

        // Check if the control has any other OPEN POA&Ms.
        const hasOtherOpenPoams = newPoamList.some(p => p.controlId === closedPoam.controlId && p.status === 'Open');

        // If no other open POA&Ms for this control, update the control status to Implemented.
        if (!hasOtherOpenPoams && newStatus === 'Closed') {
            setControls(prevControls => prevControls.map(c => {
                if (c.id === closedPoam.controlId) {
                    return { ...c, status: 'Implemented' };
                }
                return c;
            }));

            const newLogEntry = {
                timestamp: new Date().toLocaleString(),
                user: 'System: POA&M Sync',
                role: 'System',
                action: 'Control Status Sync',
                detail: `Control ${closedPoam.controlId} synchronized to 'Implemented' as all associated POA&M findings are now Closed.`,
            };
            setAuditLog(prevLog => [newLogEntry, ...prevLog]);
            setMessage(prev => ({ type: 'success', text: `${prev.text} | Control ${closedPoam.controlId} status auto-updated to Implemented.` }));
        }

        const logAction = newStatus === 'Closed' ? 'POA&M Closed/Mitigated' : 'POA&M Risk Accepted';
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRole}: Manual Action`,
            role: currentRole,
            action: logAction,
            detail: `Finding ${closedPoam.controlId} marked as ${newStatus}. Requires final eMASS update.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);
        
        setMessage(prev => ({ type: 'success', text: `POA&M finding for ${closedPoam.controlId} marked as ${newStatus}.` }));
    }
  }, [poamList, currentRole, currentRoleConfig.permissions]);

  
  // Function to export POA&M data to eMASS compatible CSV
  const exportPoamToEmassCsv = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can export POA&M findings.' });
        return;
    }

    if (poamList.length === 0) {
        setMessage({ type: 'info', text: 'Please generate POA&M entries first before exporting the CSV.' });
        return;
    }

    // Define eMASS required headers for POA&M upload (simplified set for demo)
    const headers = [
      "Control ID",
      "Finding Description",
      "Corrective Action Plan",
      "Status",
      "Responsible Organization",
      "Scheduled Completion Date (MM/DD/YYYY)",
      "Severity (High/Moderate/Low)"
    ];

    const rows = poamList.map(item => [
      item.controlId,
      `Deficiency in ${item.finding}`, // Finding Description
      item.remediation.replace(/,/g, ''), // Remove commas from text fields to avoid CSV issues
      item.status, // Use the current status (Open, Closed, Accepted)
      item.responsibleParty,
      item.dueDate, // Scheduled Completion Date
      item.severity
    ]);

    // Combine headers and rows
    const csvContent = [
      headers.join(","),
      ...rows.map(row => row.join(","))
    ].join("\n");

    // Create a Blob and initiate download
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    
    const link = document.createElement('a');
    link.href = url;
    link.download = `eMASS_POAandM_Export_${new Date().toISOString().slice(0, 10)}.csv`;
    link.click();
    URL.revokeObjectURL(url);
    
    // Log Export action
    const newLogEntry = {
        timestamp: new Date().toLocaleString(),
        user: `${currentRole}: Manual Action`,
        role: currentRole,
        action: 'eMASS POA&M Export',
        detail: `Exported ${poamList.length} POA&M findings to eMASS CSV format.`,
    };
    setAuditLog(prevLog => [newLogEntry, ...prevLog]);

    setMessage({ type: 'success', text: `POA&M data exported successfully as eMASS-compatible CSV.` });
  }, [poamList, currentRole, currentRoleConfig.permissions]);
  
  // Function to export Security Controls data to eMASS compatible CSV
  const exportControlsToEmassCsv = useCallback(() => {
      if (!currentRoleConfig.permissions.includes('edit_controls')) {
          setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can export control data.' });
          return;
      }

      if (controls.length === 0) {
          setMessage({ type: 'info', text: 'No controls loaded to export.' });
          return;
      }

      // Define expanded eMASS required headers based on the RMF Template provided by user
      const headers = [
        "Control Acronym",
        "Control Information", // Used for Title/Description
        "Control Implementation Status",
        "Control Implementation Narrative",
        "AP Acronym", // Assessment Procedure Acronym (Mocked)
        "CCI",        // Control Correlation Identifier (Mocked)
        "Date Tested",
        "Tested By",
        "Test Results", // Used for supporting artifacts/evidence
        "Inheritance Status" // NEW: Added Inheritance Status
      ];

      const dateTested = new Date().toLocaleDateString();

      const rows = controls.map(item => {
          // Mock Assessment Data based on Control ID structure
          const apAcronym = item.id.includes('(') ? `${item.id.match(/^[A-Z]{2}-\d+/)[0]} E-MOCK` : `${item.id} E-1`;
          const cciId = `CCI-${item.id.replace(/[^A-Z0-9]/g, '')}-MOCK`;
          
          return [
              item.id, // Control Acronym
              `Title: ${item.title}`, // Control Information (Simplified)
              item.status, // Control Implementation Status
              // Narrative, enclosed in quotes for multi-line/comma safety
              `"${item.procedure.replace(/"/g, '""').replace(/\n/g, ' ')}"`, 
              apAcronym, // AP Acronym (Mocked)
              cciId, // CCI (Mocked)
              dateTested, // Date Tested (Mocked)
              "Automated Engine / ISSM", // Tested By (Mocked)
              `Evidence Mapped: ${item.artifacts.join('; ').replace(/"/g, '""')}`, // Test Results (Artifacts)
              item.inheritance // Inheritance Status
          ];
      });

      // Combine headers and rows
      const csvContent = [
          headers.join(","),
          ...rows.map(row => row.join(","))
      ].join("\n");

      // Create a Blob and initiate download
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      
      const link = document.createElement('a');
      link.href = url;
      link.download = `eMASS_Controls_Export_Aligned_${new Date().toISOString().slice(0, 10)}.csv`;
      link.click();
      URL.revokeObjectURL(url);
      
      // Log Export action
      const newLogEntry = {
          timestamp: new Date().toLocaleString(),
          user: `${currentRole}: Manual Action`,
          role: currentRole,
          action: 'eMASS Controls Export (Aligned)',
          detail: `Exported ${controls.length} Security Controls to ALIGNED eMASS CSV format.`,
      };
      setAuditLog(prevLog => [newLogEntry, ...prevLog]);

      setMessage({ type: 'success', text: `Security Control implementation data exported successfully as ALIGNED eMASS-compatible CSV.` });
  }, [controls, currentRole, currentRoleConfig.permissions]);

  // Handle eMASS Baseline CSV upload (reads and overwrites control data)
  const handleEmassBaselineUpload = useCallback((event) => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can upload baseline data.' });
        return;
    }
    const file = event.target.files[0];
    if (!file) return;

    if (!file.name.toLowerCase().endsWith('.csv')) {
        setMessage({ type: 'error', text: 'Invalid file type. Please upload a CSV file compatible with eMASS exports.' });
        return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
        const text = e.target.result;
        // Simplified CSV parsing (assumes headers are in the first row)
        const lines = text.split('\n').filter(line => line.trim() !== '');
        if (lines.length < 2) {
            setMessage({ type: 'error', text: 'CSV is empty or missing data rows.' });
            return;
        }

        // Use the first row to determine the header indices
        const headers = lines[0].split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(h => h.trim().replace(/"/g, ''));
        
        const controlIdIndex = headers.indexOf('Control Acronym');
        const statusIndex = headers.indexOf('Control Implementation Status');
        const narrativeIndex = headers.indexOf('Control Implementation Narrative');
        const artifactIndex = headers.indexOf('Test Results');
        const inheritanceIndex = headers.indexOf('Inheritance Status');

        if (controlIdIndex === -1 || statusIndex === -1) {
             setMessage({ type: 'error', text: 'CSV Headers missing. Must contain "Control Acronym" and "Control Implementation Status".' });
             return;
        }
        
        const importedControls = lines.slice(1).map(line => {
            const values = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(v => v.trim().replace(/"/g, '')); 
            
            const statusRaw = values[statusIndex] || 'Not Implemented';
            const status = statusRaw.includes('Implemented') ? 'Implemented' : 
                           statusRaw.includes('Partial') ? 'Partially Implemented' : 
                           statusRaw.includes('NA') ? 'Not Applicable' : 'Not Implemented';
            
            const inheritance = (inheritanceIndex !== -1 && values[inheritanceIndex].includes('Inherited')) ? 'Inherited' : 'System Specific';

            return {
                id: values[controlIdIndex],
                status: status,
                procedure: (narrativeIndex !== -1 && values[narrativeIndex]) || `Imported SSP narrative from ${file.name}.`,
                artifacts: (artifactIndex !== -1 && values[artifactIndex]) ? values[artifactIndex].split(';').map(a => a.trim()) : [`Imported from ${file.name}`],
                inheritance: inheritance
            };
        }).filter(c => c.id);

        let updatedCount = 0;
        const newControlsMap = new Map(controls.map(c => [c.id, c]));

        importedControls.forEach(imported => {
            if (newControlsMap.has(imported.id)) {
                const existing = newControlsMap.get(imported.id);
                // Overwrite the mutable fields
                newControlsMap.set(imported.id, {
                    ...existing,
                    status: imported.status,
                    procedure: imported.procedure,
                    artifacts: imported.artifacts,
                    inheritance: imported.inheritance, // Apply inherited status from baseline
                });
                updatedCount++;
            }
        });
        
        setControls(Array.from(newControlsMap.values()));

        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRole}: Manual Action`,
            role: currentRole,
            action: 'eMASS Baseline Import',
            detail: `Imported ${updatedCount} controls from external eMASS template: ${file.name}.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'success', text: `Baseline import successful! ${updatedCount} controls have been updated using data from ${file.name}.` });
    };
    reader.readAsText(file);
    event.target.value = null; // Reset file input
  }, [controls, currentRole, currentRoleConfig.permissions]);


  // AO Sign-off function (removed for ISSM focus)
  const handleAtoDecision = (decision) => {
    // This is mocked purely for the Authorization tab interface
    const newStatus = decision === 'Approve' ? 'Approved (ATO)' : 'Denied (Risk Unacceptable)';
    setAtoStatus(newStatus);
    const newLogEntry = {
        timestamp: new Date().toLocaleString(),
        user: `AO: Jane Doe`,
        role: 'AO',
        action: 'Authorization Decision',
        detail: `System ATO Status set to: ${newStatus}.`,
    };
    setAuditLog(prevLog => [newLogEntry, ...prevLog]);
    setMessage({ type: decision === 'Approve' ? 'success' : 'error', text: `Authorization Decision Recorded: ${newStatus}.` });
  };
    
  // Function to handle manual status change via inline editor
  const handleManualStatusChange = (newStatus, controlId) => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can manually override control status.' });
