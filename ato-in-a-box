      {/* Messaging Area */}
      {message && (
        <div className={`p-4 rounded-lg mb-6 ${message.type === 'error' ? 'bg-red-900/50 text-red-300 border-red-500' : message.type === 'success' ? 'bg-green-900/50 text-green-300 border-green-500' : 'bg-blue-900/50 text-blue-300 border-blue-500'} border`} role="alert">
          {message.text}
        </div>
      )}

      {/* Tabs Navigation */}
      <div className="border-b border-gray-700 mb-6 flex space-x-4">
        <TabButton id="dashboard" label="RMF Dashboard" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
        <TabButton id="controls" label="Control Review (NIST 800-53)" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
        <TabButton id="poam" label="POA&M Automation" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
