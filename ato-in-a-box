// --- 4. MAIN APPLICATION COMPONENT ---

const App = () => {
  const [controls, setControls] = useState(initialControls);
  const [poamList, setPoamList] = useState([]);
  const [riskRegister, setRiskRegister] = useState(initialRiskData);
  const [auditLog, setAuditLog] = useState(initialAuditLog); 
  const [currentRole, setCurrentRole] = useState('ISSM');
  const [activeTab, setActiveTab] = useState('controls'); // Default to controls tab after refactor
  const [documentContent, setDocumentContent] = useState('');
  const [fileName, setFileName] = useState(''); 
  const [isProcessing, setIsProcessing] = useState(false);
  const [message, setMessage] = useState('');
  const [atoStatus, setAtoStatus] = useState('Pending Authorization'); // New state for ATO status
  const [selectedControlId, setSelectedControlId] = useState(''); // NEW: State for selected control in dropdown
  const [manualNarrative, setManualNarrative] = useState(''); // NEW: State for editing the narrative

  const currentRoleConfig = ROLES[currentRole];

  // Effect to automatically switch the AO to the sign-off tab
  useEffect(() => {
    if (currentRole === 'AO' && activeTab !== 'authorization') {
        setActiveTab('authorization');
    } else if (currentRole !== 'AO' && activeTab === 'authorization') {
        setActiveTab('dashboard');
    }
  }, [currentRole, activeTab]);

  // Sync manual narrative state with selected control's narrative
  useEffect(() => {
    const selectedControl = controls.find(c => c.id === selectedControlId);
    if (selectedControl) {
        setManualNarrative(selectedControl.procedure);
    } else {
        setManualNarrative('');
    }
  }, [selectedControlId, controls]);


  // Helper function to calculate compliance metrics
  const { total, implemented, complianceScore, readinessLevel, riskPosture } = useMemo(() => {
    const total = controls.length;
    const implemented = controls.filter(c => c.status === 'Implemented').length;
    const partiallyImplemented = controls.filter(c => c.status === 'Partially Implemented').length;
    const notImplemented = controls.filter(c => c.status === 'Not Implemented').length;
    const na = controls.filter(c => c.status === 'Not Applicable').length;
    
    // Score calculation emphasizes full implementation
    const complianceScore = Math.round(((implemented + (partiallyImplemented * 0.5)) / (total - na)) * 100) || 0;
    
    let readinessLevel = 'Low';
    if (complianceScore > 85) readinessLevel = 'High';
    else if (complianceScore > 65) readinessLevel = 'Moderate';

    let riskPosture = 'Acceptable';
    if (riskRegister.some(r => r.residualRisk.includes('Very High'))) {
        riskPosture = 'Very High Risk';
    } else if (riskRegister.some(r => r.residualRisk.includes('High'))) {
        riskPosture = 'High Risk';
    } else if (notImplemented > 0) {
        riskPosture = 'Moderate Risk';
    }


    return { total, implemented, complianceScore, readinessLevel, riskPosture };
  }, [controls, riskRegister]);

  // Handle simulated file upload (extracting filename)
  const handleFileChange = (event) => {
    const file = event.target.files[0];
    if (file) {
      setFileName(file.name);
      // NOTE: In a real app, file content would be loaded here and sent to OCR/NLP API.
      // For the simulation, we still rely on the user pasting text below.
      setMessage({ type: 'info', text: `File "${file.name}" uploaded. Processing via simulated OCR. Enter mock text below to analyze.` });
    }
  };

  // --- CORE AUTOMATION FUNCTIONS ---

  // Simulates the LLM/NLP Document Analysis (Automated Documentation Analysis)
  const handleDocumentUpload = useCallback(() => {
    if (!fileName) {
      setMessage({ type: 'error', text: 'Please upload a policy file first.' });
      return;
    }

    // --- MOCK POLICY CONTENT (Simulating OCR Output) ---
    const mockPolicyContent = `
        Section 3.1: Access Control. The organization mandates annual security training for all personnel (AT-2) and uses LMS records to verify completion. 
        Access enforcement is handled by implementing a Zero Trust Architecture (AC-3) across the network boundary. 
        Furthermore, the least privilege principle (AC-6) is strictly followed via a mandatory quarterly review of user permissions.
        Section 5.2: Media Protection. All magnetic media is destroyed or wiped according to NSS Manual 4009 (MP-6) standards by the facilities manager.
        The overall Continuous Monitoring program (CA-7) uses automated tools to check for configuration baseline enforcement (CM-6) every 12 hours.
        The formal Supply Chain Risk Management (SA-12) plan requires vetting for all COTS components before acquisition.
    `;
    const policySentences = mockPolicyContent.split('.').map(s => s.trim()).filter(s => s.length > 1);
    // --- END MOCK POLICY CONTENT ---


    if (!currentRoleConfig.permissions.includes('update_evidence')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/System Owner can update evidence via this function.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'AI/NLP Engine performing targeted extraction on uploaded policy text...' });

    // Use a timeout to simulate API latency
    setTimeout(() => {
      const newControls = [...controls];
      let controlsUpdated = 0;
      const updatedControlIds = [];
      const timestamp = new Date().toLocaleDateString();
      const artifactBaseName = fileName;

      // Map of Control IDs to their required keywords and placeholder procedures
      const controlKeywords = {
          'AC-3': { keywords: ['zero trust architecture', 'access enforcement'], procedure: null },
          'AC-6': { keywords: ['least privilege principle', 'periodic review of user permissions'], procedure: null },
          'CM-6': { keywords: ['configuration baseline enforcement', 'automated tools to check for drift'], procedure: null },
          'AT-2': { keywords: ['annual security training', 'lms records'], procedure: null },
          'MP-6': { keywords: ['media is destroyed or wiped', 'nss manual 4009'], procedure: null },
          'SA-12': { keywords: ['supply chain risk management', 'vetting for all cots components'], procedure: null },
          'CA-7': { keywords: ['continuous monitoring program', 'iscm strategy'], procedure: null },
      };

      // 1. Perform Targeted Text Extraction
      policySentences.forEach(sentence => {
          const lowerCaseSentence = sentence.toLowerCase();
          
          Object.keys(controlKeywords).forEach(controlId => {
              const controlConfig = controlKeywords[controlId];
              // Check if any keyword matches AND we haven't already found a narrative for this control
              if (!controlConfig.procedure && controlConfig.keywords.some(keyword => lowerCaseSentence.includes(keyword))) {
                  // Capture the exact sentence/phrase as the SSP narrative
                  controlKeywords[controlId].procedure = sentence.trim() + '.';
              }
          });
      });

      // 2. Update Control Status and Artifacts
      Object.keys(controlKeywords).forEach(controlId => {
          const extractedProcedure = controlKeywords[controlId].procedure;
          
          if (extractedProcedure) {
              const control = newControls.find(c => c.id === controlId);
              if (control && control.status !== 'Implemented') {
                  control.status = 'Implemented';
                  control.artifacts.push(`${artifactBaseName} - Narrative Extracted`);
                  
                  // Use the extracted sentence as the new procedure
                  control.procedure = extractedProcedure; 
                  
                  controlsUpdated++;
                  updatedControlIds.push(control.id);
              }
          }
      });
      
      setControls(newControls);

      // --- Audit Logging Logic ---
      if (controlsUpdated > 0) {
        const newLogEntry = {
          timestamp: new Date().toLocaleString(),
          user: `${currentRole}: Automated Engine`,
          role: currentRole,
          action: 'NLP/OCR Targeted Extraction',
          detail: `${controlsUpdated} controls had their narratives extracted: [${updatedControlIds.join(', ')}].`,
        };
        // Prepend the new log entry
        setAuditLog(prevLog => [newLogEntry, ...prevLog]); 
      }
      // --- End Audit Logging Logic ---
      
      setIsProcessing(false);
      setMessage({ 
          type: 'success', 
          text: `Targeted NLP Extraction complete on "${artifactBaseName}". ${controlsUpdated} controls had their narratives auto-populated: [${updatedControlIds.join(', ')}].` 
      });
    }, 2500);
  }, [controls, fileName, currentRole, currentRoleConfig.permissions]);

  // Simulates the Continuous Control Monitoring (CCM) Engine (NIST SP 800-137)
  const runContinuousMonitoring = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('view_all')) {
        setMessage({ type: 'error', text: 'Access Denied: Role must have view_all permission to run CCM.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'Initiating Continuous Monitoring Engine... Checking real-time status against authorized baseline.' });

    setTimeout(() => {
        const newControls = [...controls];
        let statusUpdates = 0;
        const timestamp = new Date().toLocaleString();

        // 1. CM-6: Configuration Settings Check (High-Value Check for Drift)
        const cm6 = newControls.find(c => c.id === 'CM-6');
        const driftDetected = Math.random() > 0.8; // 20% chance of drift failure
        
        if (cm6) {
          if (driftDetected) {
              if (cm6.status !== 'Partially Implemented') {
                  cm6.status = 'Partially Implemented';
                  cm6.artifacts.push(`CCM Alert: Baseline Drift Detected (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Baseline drift detected by monitoring agent. Manual inspection required.`;
              }
          } else {
              if (cm6.status !== 'Implemented') {
                  cm6.status = 'Implemented';
                  // Remove previous drift alerts if now passing
                  cm6.artifacts = cm6.artifacts.filter(a => !a.includes('CCM Alert')); 
                  cm6.artifacts.push(`CCM Report: Baseline Compliance Confirmed (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Configuration compliance confirmed by monitoring agent. No drift detected.`;
              }
          }
        }

        // 2. IR-4: Incident Handling (Testing for active SIEM/Ticketing integration)
