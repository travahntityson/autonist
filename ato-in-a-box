    const groupedControls = useMemo(() => {
      const groups = {};
      Object.keys(CONTROL_FAMILIES).forEach(familyCode => {
        groups[familyCode] = {
          title: CONTROL_FAMILIES[familyCode],
          controls: new Map(), // Use a map for easy parent lookups
          status: 'Not Scoped',
          totalControls: 0,
        };
      });

      // Pass 1: Build the primary control list (Base controls only)
      controls.forEach(control => {
        const isEnhancement = control.id.includes('(');
        if (!isEnhancement) {
            if (groups[control.family]) {
                groups[control.family].controls.set(control.id, {
                    ...control,
                    enhancements: [] // Add placeholder for children
                });
            }
        }
      });

      // Pass 2: Nest the enhancements under their parent
      controls.forEach(control => {
        const isEnhancement = control.id.includes('(');
        if (isEnhancement) {
            // Find the base ID (e.g., 'AC-2' from 'AC-2(1)')
            const baseIdMatch = control.id.match(/^[A-Z]{2}-\d+/);
            if (baseIdMatch && groups[control.family]) {
                const baseId = baseIdMatch[0];
                const parentControl = groups[control.family].controls.get(baseId);
                if (parentControl) {
                    parentControl.enhancements.push(control);
                }
            }
        }
      });

      // Convert the Maps back to arrays and calculate status metrics
      Object.keys(groups).forEach(familyCode => {
        const group = groups[familyCode];
        group.controls = Array.from(group.controls.values());
        
        // Calculate total controls and status based on all nested items (base + enhancements)
        const allItems = [...group.controls.flatMap(c => [c, ...c.enhancements])];
        group.totalControls = allItems.length;

        if (allItems.length === 0) {
            group.status = 'Not Scoped';
        } else if (allItems.some(c => c.status === 'Not Implemented')) {
            group.status = 'Not Implemented';
        } else if (allItems.some(c => c.status === 'Partially Implemented')) {
            group.status = 'Partially Implemented';
        } else {
            group.status = 'Implemented';
        }
      });
      
      return groups;
