const CONTROL_STATUSES = ['Implemented', 'Partially Implemented', 'Not Implemented', 'Not Applicable'];

// --- 2. MAIN APPLICATION COMPONENT ---

const App = () => {
  const [controls, setControls] = useState(initialControls);
  const [poamList, setPoamList] = useState([]);
  const [riskRegister, setRiskRegister] = useState(initialRiskData);
  const [auditLog, setAuditLog] = useState(initialAuditLog); 
  const [currentRole, setCurrentRole] = useState('ISSM');
  const [activeTab, setActiveTab] = useState('controls'); // Default to controls tab after refactor
  const [documentContent, setDocumentContent] = useState('');
  const [fileName, setFileName] = useState(''); 
  const [isProcessing, setIsProcessing] = useState(false);
  const [message, setMessage] = useState('');
  const [atoStatus, setAtoStatus] = useState('Pending Authorization'); // New state for ATO status
  const [selectedControlId, setSelectedControlId] = useState(''); // NEW: State for selected control in dropdown
  const [manualNarrative, setManualNarrative] = useState(''); // NEW: State for editing the narrative

  const currentRoleConfig = ROLES[currentRole];

  // Effect to automatically switch the AO to the sign-off tab
  useEffect(() => {
    if (currentRole === 'AO' && activeTab !== 'authorization') {
        setActiveTab('authorization');
    } else if (currentRole !== 'AO' && activeTab === 'authorization') {
        setActiveTab('dashboard');
    }
  }, [currentRole, activeTab]);

  // Sync manual narrative state with selected control's narrative
  useEffect(() => {
    const selectedControl = controls.find(c => c.id === selectedControlId);
    if (selectedControl) {
        setManualNarrative(selectedControl.procedure);
    } else {
        setManualNarrative('');
    }
  }, [selectedControlId, controls]);


  // Helper function to calculate compliance metrics
  const { total, implemented, complianceScore, readinessLevel, riskPosture } = useMemo(() => {
    const total = controls.length;
    const implemented = controls.filter(c => c.status === 'Implemented').length;
    const partiallyImplemented = controls.filter(c => c.status === 'Partially Implemented').length;
    const notImplemented = controls.filter(c => c.status === 'Not Implemented').length;
    const na = controls.filter(c => c.status === 'Not Applicable').length;
    
    // Score calculation emphasizes full implementation
    const complianceScore = Math.round(((implemented + (partiallyImplemented * 0.5)) / (total - na)) * 100) || 0;
    
    let readinessLevel = 'Low';
    if (complianceScore > 85) readinessLevel = 'High';
    else if (complianceScore > 65) readinessLevel = 'Moderate';

    let riskPosture = 'Acceptable';
    if (riskRegister.some(r => r.residualRisk.includes('Very High'))) {
        riskPosture = 'Very High Risk';
    } else if (riskRegister.some(r => r.residualRisk.includes('High'))) {
        riskPosture = 'High Risk';
    } else if (notImplemented > 0) {
        riskPosture = 'Moderate Risk';
    }


    return { total, implemented, complianceScore, readinessLevel, riskPosture };
  }, [controls, riskRegister]);

  // Handle simulated file upload (extracting filename)
  const handleFileChange = (event) => {
    const file = event.target.files[0];
    if (file) {
      setFileName(file.name);
      // NOTE: In a real app, file content would be loaded here and sent to OCR/NLP API.
      // For the simulation, we still rely on the user pasting text below.
      setMessage({ type: 'info', text: `File "${file.name}" uploaded. Processing via simulated OCR. Paste extracted text below to analyze.` });
    }
  };

  // --- 3. CORE AUTOMATION FUNCTIONS ---

  // Simulates the LLM/NLP Document Analysis (Automated Documentation Analysis)
  const handleDocumentUpload = useCallback(() => {
    if (!documentContent) {
      setMessage({ type: 'error', text: 'Please paste the OCR/extracted text to analyze.' });
      return;
    }

    if (!currentRoleConfig.permissions.includes('update_evidence')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/System Owner can update evidence via this function.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'AI/NLP Engine performing inference on extracted policy text... (Simulated LLM Analysis)' });

    // Use a timeout to simulate API latency
    setTimeout(() => {
      const newControls = [...controls];
      let controlsUpdated = 0;
      const lowerCaseContent = documentContent.toLowerCase();
      const timestamp = new Date().toLocaleDateString();
      // Use the simulated file name if available, otherwise use a generic name
      const artifactBaseName = fileName || `Policy Document (${timestamp})`;

      // Mock AI/NLP Inference Logic: Map keywords to control status updates
      
      // AC-3: Access Enforcement (ZTA)
      if (lowerCaseContent.includes('zero trust architecture') || lowerCaseContent.includes('least privilege principle')) {
        const ac3 = newControls.find(c => c.id === 'AC-3');
        if (ac3 && ac3.status !== 'Implemented') {
          ac3.status = 'Implemented';
          ac3.artifacts.push(`${artifactBaseName} - ZTA Confirmed`);
          controlsUpdated++;
          ac3.procedure = `NLP CONFIRMATION: ZTA enforcement confirmed via policy. Access control mechanism verified via automated checks.`;
        }
      }

      // AC-6: Least Privilege
      if (lowerCaseContent.includes('access granted only as necessary') || lowerCaseContent.includes('periodic review of user permissions')) {
        const ac6 = newControls.find(c => c.id === 'AC-6');
        if (ac6 && ac6.status !== 'Implemented') {
          ac6.status = 'Implemented';
          ac6.artifacts.push(`${artifactBaseName} - Least Privilege Policy Confirmed`);
          controlsUpdated++;
          ac6.procedure = `NLP CONFIRMATION: Policy requires periodic review of user permissions to enforce least privilege.`;
        }
      }

      // AU-6: Audit Review, Analysis, and Reporting
      if (lowerCaseContent.includes('daily log review') || lowerCaseContent.includes('incident analysts review logs')) {
        const au6 = newControls.find(c => c.id === 'AU-6');
        if (au6 && au6.status !== 'Implemented') {
          au6.status = 'Implemented';
          au6.artifacts.push(`${artifactBaseName} - Log Review Policy Confirmed`);
          controlsUpdated++;
          au6.procedure = `NLP CONFIRMATION: Policy mandates daily log review by incident analysts and automated reporting to SIEM.`;
        }
      }

      // CM-6: Configuration Settings
      if (lowerCaseContent.includes('configuration baseline enforcement') || lowerCaseContent.includes('continuous monitoring for drift')) {
        const cm6 = newControls.find(c => c.id === 'CM-6');
        if (cm6 && cm6.status !== 'Implemented') {
          cm6.status = 'Implemented';
          cm6.artifacts.push(`${artifactBaseName} - CM Baseline Confirmed`);
          controlsUpdated++;
          cm6.procedure = `NLP CONFIRMATION: Continuous monitoring for configuration drift is documented and enforced by automated tools.`;
        }
      }

      // AT-2: Security Awareness Training
      if (lowerCaseContent.includes('annual security training') || lowerCaseContent.includes('lms records')) {
        const at2 = newControls.find(c => c.id === 'AT-2');
        if (at2 && at2.status !== 'Implemented') {
          at2.status = 'Implemented';
          at2.artifacts.push(`${artifactBaseName} - Training Compliance Confirmed`);
          controlsUpdated++;
          at2.procedure = `NLP CONFIRMATION: Annual security training requirement verified. LMS records are being tracked.`;
        }
      }

      // MP-6: Media Sanitization
      if (lowerCaseContent.includes('nss manual 4009') || lowerCaseContent.includes('destroying or wiping media')) {
        const mp6 = newControls.find(c => c.id === 'MP-6');
        if (mp6 && mp6.status !== 'Implemented') {
          mp6.status = 'Implemented';
          mp6.artifacts.push(`${artifactBaseName} - Sanitization Policy Confirmed`);
          controlsUpdated++;
          mp6.procedure = `NLP CONFIRMATION: Media sanitization procedures follow NSS Manual 4009 standards for destruction and cryptographic erase.`;
        }
      }

      // SA-12: Supply Chain Protection (SCRM)
      if (lowerCaseContent.includes('supply chain risk management') || lowerCaseContent.includes('vetted cots components')) {
        const sa12 = newControls.find(c => c.id === 'SA-12');
        if (sa12 && sa12.status !== 'Implemented') {
          sa12.status = 'Implemented';
          sa12.artifacts.push(`${artifactBaseName} - SCRM Policy Confirmed`);
          controlsUpdated++;
          sa12.procedure = `NLP CONFIRMATION: Formal SCRM plan is in place, requiring vetting for all COTS components before acquisition.`;
        }
      }


      setControls(newControls);

      // --- Audit Logging Logic ---
      if (controlsUpdated > 0) {
        const newLogEntry = {
          timestamp: new Date().toLocaleString(),
          user: `${currentRole}: Automated Engine`,
          role: currentRole,
          action: 'NLP/OCR Evidence Ingestion',
          detail: `${controlsUpdated} controls were automatically updated and evidence mapped from ${artifactBaseName}.`,
        };
        // Prepend the new log entry
        setAuditLog(prevLog => [newLogEntry, ...prevLog]); 
      }
      // --- End Audit Logging Logic ---
      
      setIsProcessing(false);
      setMessage({ type: 'success', text: `NLP Analysis complete. ${controlsUpdated} controls were automatically updated and evidence mapped from ${artifactBaseName}.` });
    }, 2500);
  }, [documentContent, controls, fileName, currentRole, currentRoleConfig.permissions]);

  // Simulates the Continuous Control Monitoring (CCM) Engine (NIST SP 800-137)
  const runContinuousMonitoring = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('view_all')) {
        setMessage({ type: 'error', text: 'Access Denied: Role must have view_all permission to run CCM.' });
        return;
    }

    setIsProcessing(true);
    setMessage({ type: 'info', text: 'Initiating Continuous Monitoring Engine... Checking real-time status against authorized baseline.' });

    setTimeout(() => {
        const newControls = [...controls];
        let statusUpdates = 0;
        const timestamp = new Date().toLocaleString();

        // 1. CM-6: Configuration Settings Check (High-Value Check for Drift)
        const cm6 = newControls.find(c => c.id === 'CM-6');
        const driftDetected = Math.random() > 0.8; // 20% chance of drift failure
        
        if (cm6) {
          if (driftDetected) {
              if (cm6.status !== 'Partially Implemented') {
                  cm6.status = 'Partially Implemented';
                  cm6.artifacts.push(`CCM Alert: Baseline Drift Detected (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Baseline drift detected by monitoring agent. Manual inspection required.`;
              }
          } else {
              if (cm6.status !== 'Implemented') {
                  cm6.status = 'Implemented';
                  // Remove previous drift alerts if now passing
                  cm6.artifacts = cm6.artifacts.filter(a => !a.includes('CCM Alert')); 
                  cm6.artifacts.push(`CCM Report: Baseline Compliance Confirmed (${timestamp})`);
                  statusUpdates++;
                  cm6.procedure = `CCM UPDATE: Configuration compliance confirmed by monitoring agent. No drift detected.`;
              }
          }
        }

        // 2. IR-4: Incident Handling (Testing for active SIEM/Ticketing integration)
        const ir4 = newControls.find(c => c.id === 'IR-4');
        const activeMonitoring = Math.random() > 0.1; // 90% chance of passing
        
        if (ir4) {
          if (activeMonitoring) {
              if (ir4.status !== 'Implemented') {
                  ir4.status = 'Implemented';
                  ir4.artifacts.push(`CCM Report: SIEM/Ticketing Integration Confirmed Active (${timestamp})`);
                  statusUpdates++;
                  ir4.procedure = `CCM UPDATE: Active monitoring and SIEM integration verified. Automated containment working.`;
              }
          } else {
              if (ir4.status !== 'Partially Implemented') {
                  ir4.status = 'Partially Implemented';
                  ir4.artifacts.push(`CCM Alert: SIEM Integration Failed/Inactive (${timestamp})`);
                  statusUpdates++;
                  ir4.procedure = `CCM UPDATE: SIEM feed connectivity test failed. Manual check required.`;
              }
          }
        }

        // 3. AU-6: Audit Review, Analysis, and Reporting check
        const au6 = newControls.find(c => c.id === 'AU-6');
        const reportingSuccess = Math.random() > 0.2; // 80% chance of success
        if (au6) {
          if (reportingSuccess) {
            if (au6.status !== 'Implemented') {
              au6.status = 'Implemented';
              au6.artifacts.push(`CCM Report: Daily Audit Report Generation Confirmed (${timestamp})`);
              statusUpdates++;
              au6.procedure = `CCM UPDATE: Daily audit report generation service is operational.`;
            }
          } else {
            if (au6.status !== 'Partially Implemented') {
              au6.status = 'Partially Implemented';
              au6.artifacts.push(`CCM Alert: Audit Report Failure/Delay Detected (${timestamp})`);
              statusUpdates++;
              au6.procedure = `CCM UPDATE: Daily audit report generation service failed. POA&M entry required.`;
            }
          }
        }
        
        setControls(newControls);

        // Audit Logging for CCM
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRole}: Automated Engine`,
            role: 'System',
            action: 'Continuous Monitoring Run',
            detail: `CCM completed. ${statusUpdates} control status changes detected.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]); 

        setIsProcessing(false);
        setMessage({ type: 'success', text: `CCM Run Complete: ${statusUpdates} control statuses updated based on real-time data feeds. Check Control Review for details.` });

    }, 3000); // Simulate 3 seconds for the comprehensive scan
  }, [controls, currentRole, currentRoleConfig.permissions]);


  // Simulates POA&M Automation (Generate Plan of Action & Milestones)
  const generatePOAandM = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can generate POA&M entries.' });
        return;
    }
    
    const deficiencies = controls.filter(c => c.status !== 'Implemented' && c.status !== 'Not Applicable');
    
    if (deficiencies.length === 0) {
      setMessage({ type: 'info', text: 'No deficiencies found. All scoped controls are Implemented.' });
      setPoamList([]);
      return;
    }

    const newPoamList = deficiencies.map(c => {
      const existing = poamList.find(p => p.controlId === c.id);
      if (existing) return existing; // Keep existing POA&Ms if they haven't been resolved

      // POA&M Automation Logic: Determine details based on control metadata
      let remediationSteps = `Develop and implement a complete policy for ${c.title}.`;
      let dueDate = new Date();
      
      switch (c.severity) {
        case 'High':
          dueDate.setDate(dueDate.getDate() + 90); // 90 days for High
          remediationSteps = `HIGH PRIORITY: Implement system requirements for ${c.id} and document the fix for auditor review.`;
          break;
        case 'Moderate':
          dueDate.setDate(dueDate.getDate() + 180); // 180 days for Moderate
          break;
        default:
          dueDate.setDate(dueDate.getDate() + 365); // 365 days for Low
      }

      return {
        id: crypto.randomUUID(),
        controlId: c.id,
        finding: `${c.id} (${c.title}) is currently ${c.status}.`,
        severity: c.severity,
        remediation: remediationSteps,
        responsibleParty: c.family === 'AC' ? 'System Owner' : 'ISSM',
        dueDate: dueDate.toLocaleDateString(),
        status: 'Open',
        creationDate: new Date().toLocaleDateString(),
      };
    });
    
    setPoamList(newPoamList);
    
    // Log POA&M Generation action
    const newLogEntry = {
        timestamp: new Date().toLocaleString(),
        user: `${currentRole}: Manual Action`,
        role: currentRole,
        action: 'POA&M Generation',
        detail: `Generated new POA&M list. ${newPoamList.length} deficiencies detected.`,
    };
    setAuditLog(prevLog => [newLogEntry, ...prevLog]);

    setMessage({ type: 'success', text: `POA&M generated successfully. ${newPoamList.length} deficiencies detected and logged.` });
  }, [controls, poamList, currentRole, currentRoleConfig.permissions]);
  
  // Function to export POA&M data to eMASS compatible CSV
  const exportPoamToEmassCsv = useCallback(() => {
    if (!currentRoleConfig.permissions.includes('edit_controls')) {
        setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can export POA&M findings.' });
        return;
    }

    if (poamList.length === 0) {
        setMessage({ type: 'info', text: 'Please generate POA&M entries first before exporting the CSV.' });
        return;
    }

    // Define eMASS required headers for POA&M upload (simplified set for demo)
    const headers = [
      "Control ID",
      "Finding Description",
      "Corrective Action Plan",
      "Status",
      "Responsible Organization",
      "Scheduled Completion Date (MM/DD/YYYY)",
      "Severity (High/Moderate/Low)"
    ];

    const rows = poamList.map(item => [
      item.controlId,
      `Deficiency in ${item.finding}`, // Finding Description
      item.remediation.replace(/,/g, ''), // Remove commas from text fields to avoid CSV issues
      "Open", // Status
      item.responsibleParty,
      item.dueDate, // Scheduled Completion Date
      item.severity
    ]);

    // Combine headers and rows
    const csvContent = [
      headers.join(","),
      ...rows.map(row => row.join(","))
    ].join("\n");

    // Create a Blob and initiate download
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    
