        return;
    }
    const file = event.target.files[0];
    if (!file) return;

    if (!file.name.toLowerCase().endsWith('.csv')) {
        setMessage({ type: 'error', text: 'Invalid file type. Please upload a CSV file compatible with eMASS exports.' });
        return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
        const text = e.target.result;
        // Simplified CSV parsing (assumes headers are in the first row)
        const lines = text.split('\n').filter(line => line.trim() !== '');
        if (lines.length < 2) {
            setMessage({ type: 'error', text: 'CSV is empty or missing data rows.' });
            return;
        }

        const headers = lines[0].split(',').map(h => h.trim().replace(/"/g, ''));
        
        // Determine column indices based on expected eMASS headers
        const controlIdIndex = headers.indexOf('Control Acronym');
        const statusIndex = headers.indexOf('Control Implementation Status');
        const narrativeIndex = headers.indexOf('Control Implementation Narrative');
        const artifactIndex = headers.indexOf('Test Results');

        if (controlIdIndex === -1 || statusIndex === -1) {
             setMessage({ type: 'error', text: 'CSV Headers missing. Must contain "Control Acronym" and "Control Implementation Status".' });
             return;
        }
        
        const importedControls = lines.slice(1).map(line => {
            const values = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(v => v.trim().replace(/"/g, '')); // Robust split ignoring commas inside quotes
            
            const statusRaw = values[statusIndex] || 'Not Implemented';
            const status = statusRaw.includes('Implemented') ? 'Implemented' : 
                           statusRaw.includes('Partial') ? 'Partially Implemented' : 
                           statusRaw.includes('NA') ? 'Not Applicable' : 'Not Implemented';
            
            return {
                id: values[controlIdIndex],
                status: status,
                procedure: (narrativeIndex !== -1 && values[narrativeIndex]) || 'Imported SSP narrative.',
                artifacts: (artifactIndex !== -1 && values[artifactIndex]) ? values[artifactIndex].split(';').map(a => a.trim()) : [`Imported from ${file.name}`]
            };
        }).filter(c => c.id); // Filter out any empty lines/invalid IDs

        let updatedCount = 0;
        const newControlsMap = new Map(controls.map(c => [c.id, c]));

        importedControls.forEach(imported => {
            if (newControlsMap.has(imported.id)) {
                const existing = newControlsMap.get(imported.id);
                // Overwrite the mutable fields
                newControlsMap.set(imported.id, {
                    ...existing,
                    status: imported.status,
                    procedure: imported.procedure,
                    artifacts: imported.artifacts,
                });
                updatedCount++;
            }
        });
        
        setControls(Array.from(newControlsMap.values()));

        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRole}: Manual Action`,
            role: currentRole,
            action: 'eMASS Baseline Import',
            detail: `Imported ${updatedCount} controls from external eMASS template: ${file.name}.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'success', text: `Baseline import successful! ${updatedCount} controls have been updated using data from ${file.name}.` });
    };
    reader.readAsText(file);
