              <MetricCard title="Risk Posture" value={riskPosture} className={`col-span-2 md:col-span-1 ${riskPosture.includes('High') ? 'bg-red-900/50' : riskPosture.includes('Moderate') ? 'bg-yellow-900/50' : 'bg-green-900/50'}`} />

              <div className="md:col-span-4 p-6 rounded-xl shadow-xl bg-white/10 border border-gray-700/50">
                  <h3 className="text-xl font-semibold mb-4 text-cyan-400">Compliance Heat Map (1,189 Controls Scoped)</h3>
                  <p className="text-lg mb-2">Controls Implemented: <span className="font-bold text-green-400">{implemented}</span> / <span className="font-bold">{total}</span></p>
