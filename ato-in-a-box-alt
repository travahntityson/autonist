// --- MOCK SERVICE LAYER (New 'services/complianceEngine.js' equivalent) ---

// Simulates the LLM/NLP Document Analysis (Replaces the bulk of handleDocumentUpload)
const mockNlpService = async (controls, fileName) => {
    return new Promise(resolve => {
        setTimeout(() => {
            const mockPolicyContent = `
                Section 3.1: Access Control. The organization mandates annual security training for all personnel (AT-2) and uses LMS records to verify completion. 
                Access enforcement is handled by implementing a Zero Trust Architecture (AC-3) across the network boundary. 
                Furthermore, the least privilege principle (AC-6) is strictly followed via a mandatory quarterly review of user permissions.
                Section 5.2: Media Protection. All magnetic media is destroyed or wiped according to NSS Manual 4009 (MP-6) standards by the facilities manager.
                The overall Continuous Monitoring program (CA-7) uses automated tools to check for configuration baseline enforcement (CM-6) every 12 hours.
                The formal Supply Chain Risk Management (SA-12) plan requires vetting for all COTS components before acquisition.
            `;
            const mockCciFindings = [
                { cci: 'CCI-000200', controlId: 'AC-3', status: 'Pass', artifact: 'NIST STIG Report' },
                { cci: 'CCI-000343', controlId: 'IR-5', status: 'Fail', artifact: 'ACAS Scan Report' },
                { cci: 'CCI-000180', controlId: 'SI-10', status: 'Pass', artifact: 'SAST Tool Report' },
            ];

            // ... [The complex NLP/CCI logic from original handleDocumentUpload remains here] ...
            
            const newControls = [...controls];
            let controlsUpdated = 0;
            const updatedControlIds = [];
            const cciToControlMap = new Map(mockCciFindings.map(f => [f.controlId, f]));
            const policySentences = mockPolicyContent.split('.').map(s => s.trim()).filter(s => s.length > 1);
            const artifactBaseName = fileName;

            const controlKeywords = { /* ... controlKeywords from original code ... */
                'AC-3': { keywords: ['zero trust architecture', 'access enforcement'], procedure: null, updatedBy: null },
                'AC-6': { keywords: ['least privilege principle', 'periodic review of user permissions'], procedure: null, updatedBy: null },
                'CM-6': { keywords: ['configuration baseline enforcement', 'automated tools to check for drift'], procedure: null, updatedBy: null },
                'AT-2': { keywords: ['annual security training', 'lms records'], procedure: null, updatedBy: null },
                'MP-6': { keywords: ['media is destroyed or wiped', 'nss manual 4009'], procedure: null, updatedBy: null },
                'SA-12': { keywords: ['supply chain risk management', 'vetting for all cots components'], procedure: null, updatedBy: null },
                'CA-7': { keywords: ['continuous monitoring program', 'iscm strategy'], procedure: null, updatedBy: null },
                'IR-5': { keywords: [], procedure: null, updatedBy: null },
                'SI-10': { keywords: [], procedure: null, updatedBy: null },
            };
            
            // STAGE 1: RAG Extraction
            policySentences.forEach(sentence => {
                const lowerCaseSentence = sentence.toLowerCase();
                Object.keys(controlKeywords).forEach(controlId => {
                    const controlConfig = controlKeywords[controlId];
                    if (!controlConfig.procedure && controlConfig.keywords.length > 0 && controlConfig.keywords.some(keyword => lowerCaseSentence.includes(keyword))) {
                        controlKeywords[controlId].procedure = sentence.trim() + '.';
                        controlKeywords[controlId].updatedBy = 'RAG Engine';
                    }
                });
            });

            // STAGE 2: CCI Contingency
            Object.keys(controlKeywords).forEach(controlId => {
                const controlConfig = controlKeywords[controlId];
                const cciFinding = cciToControlMap.get(controlId);
                if (!controlConfig.updatedBy && cciFinding) {
                    const status = cciFinding.status === 'Pass' ? 'Implemented' : 'Partially Implemented';
                    const procedure = `CCI CONTINGENCY: Status auto-set to ${status} via technical finding ${cciFinding.cci}. Artifact: ${cciFinding.artifact}.`;
                    controlKeywords[controlId].procedure = procedure;
                    controlKeywords[controlId].updatedBy = `CCI Check (${cciFinding.cci})`;
                }
            });

            // STAGE 3: Apply Updates
            Object.keys(controlKeywords).forEach(controlId => {
                const updateSource = controlKeywords[controlId].updatedBy;
                if (updateSource) {
                    const control = newControls.find(c => c.id === controlId);
                    if (control) {
                        let status = control.status;
                        let procedure = controlKeywords[controlId].procedure;
                        let artifact = `${artifactBaseName} - ${updateSource}`;

                        if (updateSource.startsWith('CCI Check')) {
                            status = procedure.includes('Implemented') ? 'Implemented' : 'Partially Implemented';
                            artifact = `${cciToControlMap.get(controlId).artifact}`;
                            procedure = procedure.replace('CCI CONTINGENCY: ', '');
                        } else {
                            status = 'Implemented';
                        }
                        
                        if (control.status !== status || !control.procedure.includes('Automated Engine')) {
                            control.status = status;
                            controlsUpdated++;
                        }
                        
                        control.procedure = procedure;
                        if (!control.artifacts.includes(artifact)) {
                            control.artifacts.push(artifact);
                        }
                        updatedControlIds.push(control.id);
                    }
                }
            });

            resolve({ newControls, controlsUpdated, updatedControlIds, artifactBaseName });
        }, 2500);
    });
};

// Simulates the CCM Engine (Replaces the bulk of runContinuousMonitoring)
const mockCcmService = async (controls) => {
    return new Promise(resolve => {
        setTimeout(() => {
            const newControls = [...controls];
            let statusUpdates = 0;
            const timestamp = new Date().toLocaleString();

            const updates = {};

            // 1. CM-6: Configuration Settings Check (20% chance of drift)
            const cm6 = newControls.find(c => c.id === 'CM-6');
            const driftDetected = Math.random() > 0.8;
            if (cm6) {
                if (driftDetected) {
                    if (cm6.status !== 'Partially Implemented') {
                        cm6.status = 'Partially Implemented';
                        cm6.artifacts.push(`CCM Alert: Baseline Drift Detected (${timestamp})`);
                        cm6.procedure = `CCM UPDATE: Baseline drift detected by monitoring agent. Manual inspection required.`;
                        statusUpdates++;
                    }
                } else {
                    if (cm6.status !== 'Implemented') {
                        cm6.status = 'Implemented';
                        cm6.artifacts = cm6.artifacts.filter(a => !a.includes('CCM Alert')); 
                        cm6.artifacts.push(`CCM Report: Baseline Compliance Confirmed (${timestamp})`);
                        cm6.procedure = `CCM UPDATE: Configuration compliance confirmed by monitoring agent. No drift detected.`;
                        statusUpdates++;
                    }
                }
                updates['CM-6'] = cm6;
            }

            // 2. IR-4: Incident Handling (10% chance of failure)
            const ir4 = newControls.find(c => c.id === 'IR-4');
            const activeMonitoring = Math.random() > 0.1;
            if (ir4) {
                if (!activeMonitoring) {
                    if (ir4.status !== 'Partially Implemented') {
                        ir4.status = 'Partially Implemented';
                        ir4.artifacts.push(`CCM Alert: SIEM Integration Failed/Inactive (${timestamp})`);
                        ir4.procedure = `CCM UPDATE: SIEM feed connectivity test failed. Manual check required.`;
                        statusUpdates++;
                    }
                } else {
                    if (ir4.status !== 'Implemented') {
                        ir4.status = 'Implemented';
                        ir4.artifacts.push(`CCM Report: SIEM/Ticketing Integration Confirmed Active (${timestamp})`);
                        ir4.procedure = `CCM UPDATE: Active monitoring and SIEM integration verified. Automated containment working.`;
                        statusUpdates++;
                    }
                }
                updates['IR-4'] = ir4;
            }
            // 3. AU-6: Audit Review, Analysis, and Reporting check (20% chance of failure)
            const au6 = newControls.find(c => c.id === 'AU-6');
            const reportingSuccess = Math.random() > 0.2;
            if (au6) {
              if (reportingSuccess) {
                if (au6.status !== 'Implemented') {
                  au6.status = 'Implemented';
                  au6.artifacts.push(`CCM Report: Daily Audit Report Generation Confirmed (${timestamp})`);
                  statusUpdates++;
                  au6.procedure = `CCM UPDATE: Daily audit report generation service is operational.`;
                }
              } else {
                if (au6.status !== 'Partially Implemented') {
                  au6.status = 'Partially Implemented';
                  au6.artifacts.push(`CCM Alert: Audit Report Failure/Delay Detected (${timestamp})`);
                  statusUpdates++;
                  au6.procedure = `CCM UPDATE: Daily audit report generation service failed. POA&M entry required.`;
                }
              }
              updates['AU-6'] = au6;
            }

            resolve({ newControls, statusUpdates, updates });
        }, 3000);
    });
};


// --- 2. LOGIC LAYER (The new 'useRmfAutomation' Custom Hook) ---

const useRmfAutomation = (currentRoleConfig, setAuditLog, setMessage) => {
    // Dynamic initialization of controls and assessments from the generator function
    const { initialControls, initialAssessments } = useMemo(() => {
        try {
             return createFullControlCatalog();
        } catch (error) {
            console.error("Failed to load initial control catalog:", error);
            // Fallback to empty state
            return { initialControls: [], initialAssessments: [] };
        }
    }, []); // Error handling added per review note

    const [controls, setControls] = useState(initialControls);
    const [poamList, setPoamList] = useState([]);
    const [assessments] = useState(initialAssessments);
    const [fileName, setFileName] = useState('');
    const [isProcessing, setIsProcessing] = useState(false);
    
    // States for inline editor logic (kept here for simplicity/data binding)
    const [openControlId, setOpenControlId] = useState('');
    const [localNarrative, setLocalNarrative] = useState({});

    // Sync manual narrative state with selected control's narrative
    useEffect(() => {
        const selectedControl = controls.find(c => c.id === openControlId);
        if (selectedControl) {
            setLocalNarrative(prev => ({ ...prev, [openControlId]: selectedControl.procedure }));
        } else {
            setLocalNarrative({});
        }
    }, [openControlId, controls]);


    // Helper function to calculate compliance metrics (Memoized)
    const { total, implemented, complianceScore, readinessLevel, riskPosture } = useMemo(() => {
        const total = controls.length;
        const implemented = controls.filter(c => c.status === 'Implemented').length;
        const partiallyImplemented = controls.filter(c => c.status === 'Partially Implemented').length;
        const notImplemented = controls.filter(c => c.status === 'Not Implemented').length;
        const na = controls.filter(c => c.status === 'Not Applicable').length;
        
        // Score calculation emphasizes full implementation
        const complianceScore = Math.round(((implemented + (partiallyImplemented * 0.5)) / (total - na)) * 100) || 0;
        
        let readinessLevel = 'Low';
        if (complianceScore > 85) readinessLevel = 'High';
        else if (complianceScore > 65) readinessLevel = 'Moderate';

        // Derive Risk Posture from high-severity open POA&Ms
        let riskPosture = 'Acceptable';
        const highSeverityPoams = poamList.filter(p => p.status === 'Open' && p.severity === 'High');
        
        if (highSeverityPoams.length > 5) {
            riskPosture = 'Very High Risk';
        } else if (highSeverityPoams.length > 0) {
            riskPosture = 'High Risk';
        } else if (notImplemented > 0) {
            riskPosture = 'Moderate Risk';
        }

        return { total, implemented, complianceScore, readinessLevel, riskPosture };
    }, [controls, poamList]);


    // CORE AUTOMATION FUNCTION 1: NLP/CCI Document Analysis
    const handleDocumentUpload = useCallback(async () => {
        if (!fileName) {
            setMessage({ type: 'error', text: 'Please upload a policy file first.' });
            return;
        }
        if (!currentRoleConfig.permissions.includes('update_evidence')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/System Owner can update evidence via this function.' });
            return;
        }

        setIsProcessing(true);
        setMessage({ type: 'info', text: 'AI/NLP Engine performing targeted extraction on uploaded policy text...' });

        try {
            const { newControls, controlsUpdated, updatedControlIds, artifactBaseName } = await mockNlpService(controls, fileName);
            
            setControls(newControls);

            if (controlsUpdated > 0) {
                const newLogEntry = {
                    timestamp: new Date().toLocaleString(),
                    user: `${currentRoleConfig.name}: Automated Engine`,
                    role: 'System',
                    action: 'NLP/CCI Automated Check',
                    detail: `${controlsUpdated} control status(es) updated: [${updatedControlIds.join(', ')}].`,
                };
                setAuditLog(prevLog => [newLogEntry, ...prevLog]); 
            }
            
            setMessage({ 
                type: 'success', 
                text: `Automated Analysis Complete on "${artifactBaseName}". ${updatedControlIds.length} controls were updated via RAG/CCI: [${updatedControlIds.join(', ')}].` 
            });

        } catch (e) {
            setMessage({ type: 'error', text: `NLP Service Error: ${e.message}` });
            console.error(e);
        } finally {
            setIsProcessing(false);
        }

    }, [controls, fileName, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]); // Added dependency array for stability

    // CORE AUTOMATION FUNCTION 2: Continuous Control Monitoring (CCM)
    const runContinuousMonitoring = useCallback(async () => {
        if (!currentRoleConfig.permissions.includes('view_all')) {
            setMessage({ type: 'error', text: 'Access Denied: Role must have view_all permission to run CCM.' });
            return;
        }

        setIsProcessing(true);
        setMessage({ type: 'info', text: 'Initiating Continuous Monitoring Engine... Checking real-time status against authorized baseline.' });

        try {
            const { newControls, statusUpdates } = await mockCcmService(controls);

            setControls(newControls);

            // Audit Logging for CCM
            const newLogEntry = {
                timestamp: new Date().toLocaleString(),
                user: `${currentRoleConfig.name}: Automated Engine`,
                role: 'System',
                action: 'Continuous Monitoring Run',
                detail: `CCM completed. ${statusUpdates} control status changes detected.`,
            };
            setAuditLog(prevLog => [newLogEntry, ...prevLog]); 

            setMessage({ type: 'success', text: `CCM Run Complete: ${statusUpdates} control statuses updated based on real-time data feeds. Check Control Review for details.` });

        } catch (e) {
            setMessage({ type: 'error', text: `CCM Service Error: ${e.message}` });
            console.error(e);
        } finally {
            setIsProcessing(false);
        }
        
    }, [controls, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]);

    // CORE AUTOMATION FUNCTION 3: POA&M Generation
    const generatePOAandM = useCallback(() => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can generate POA&M entries.' });
            return;
        }
        
        // Find all controls that are not fully implemented and are not currently in an 'Open' POA&M
        const deficiencies = controls.filter(c => 
            c.status !== 'Implemented' && 
            c.status !== 'Not Applicable' &&
            !poamList.some(p => p.controlId === c.id && p.status === 'Open')
        );
        
        if (deficiencies.length === 0) {
            setMessage({ type: 'info', text: 'No new deficiencies found. All current findings are either Implemented or already in the Open POA&M list.' });
            return;
        }

        const newPoamEntries = deficiencies.map(c => {
            // POA&M Automation Logic: Determine details based on control metadata
            let remediationSteps = `Investigate deficiency in ${c.title}.`;
            let dueDate = new Date();
            
            switch (c.severity) {
                case 'High':
                    dueDate.setDate(dueDate.getDate() + 90); 
                    remediationSteps = `HIGH PRIORITY: Implement system requirements for ${c.id} and document the fix for auditor review.`;
                    break;
                case 'Moderate':
                    dueDate.setDate(dueDate.getDate() + 180);
                    break;
                default:
                    dueDate.setDate(dueDate.getDate() + 365);
            }

            return {
                id: crypto.randomUUID(),
                controlId: c.id,
                finding: `${c.id} (${c.title}) is currently ${c.status}.`,
                severity: c.severity,
                remediation: remediationSteps,
                responsibleParty: c.family === 'AC' ? 'System Owner' : 'ISSM',
                dueDate: dueDate.toLocaleDateString(),
                status: 'Open',
                creationDate: new Date().toLocaleDateString(),
            };
        });
        
        setPoamList(prev => [...prev.filter(p => p.status === 'Open'), ...newPoamEntries]);
        
        // Log POA&M Generation action
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRoleConfig.name}: Manual Action`,
            role: currentRoleConfig.name,
            action: 'POA&M Generation',
            detail: `Generated new POA&M list. ${newPoamEntries.length} new deficiencies detected.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'success', text: `POA&M generated successfully. ${newPoamEntries.length} new deficiencies detected and logged.` });
    }, [controls, poamList, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]);


    // CORE FUNCTION 4: Handle POA&M closure/mitigation
    const handlePoamClosure = useCallback((poamId, newStatus) => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can close POA&M entries.' });
            return;
        }

        let closedPoam;
        const newPoamList = poamList.map(p => {
            if (p.id === poamId) {
                closedPoam = p;
                return { ...p, status: newStatus, closureDate: new Date().toLocaleDateString() };
            }
            return p;
        });

        if (closedPoam) {
            setPoamList(newPoamList);

            // Check if the control has any other OPEN POA&Ms.
            const hasOtherOpenPoams = newPoamList.some(p => p.controlId === closedPoam.controlId && p.status === 'Open');

            // If no other open POA&Ms for this control, update the control status to Implemented.
            if (!hasOtherOpenPoams && newStatus === 'Closed') {
                setControls(prevControls => prevControls.map(c => {
                    if (c.id === closedPoam.controlId) {
                        return { ...c, status: 'Implemented' };
                    }
                    return c;
                }));

                const newLogEntry = {
                    timestamp: new Date().toLocaleString(),
                    user: 'System: POA&M Sync',
                    role: 'System',
                    action: 'Control Status Sync',
                    detail: `Control ${closedPoam.controlId} synchronized to 'Implemented' as all associated POA&M findings are now Closed.`,
                };
                setAuditLog(prevLog => [newLogEntry, ...prevLog]);
                setMessage(prev => ({ type: 'success', text: `POA&M finding for ${closedPoam.controlId} marked as ${newStatus}. | Control ${closedPoam.controlId} status auto-updated to Implemented.` }));
                return; // Exit after setting combined message
            }

            const logAction = newStatus === 'Closed' ? 'POA&M Closed/Mitigated' : 'POA&M Risk Accepted';
            const newLogEntry = {
                timestamp: new Date().toLocaleString(),
                user: `${currentRoleConfig.name}: Manual Action`,
                role: currentRoleConfig.name,
                action: logAction,
                detail: `Finding ${closedPoam.controlId} marked as ${newStatus}. Requires final eMASS update.`,
            };
            setAuditLog(prevLog => [newLogEntry, ...prevLog]);
            
            setMessage({ type: 'success', text: `POA&M finding for ${closedPoam.controlId} marked as ${newStatus}.` });
        }
    }, [poamList, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setControls, setMessage]);

    // CORE FUNCTION 5: Manual Narrative Save Logic
    const handleSaveNarrative = useCallback((controlId, newNarrative) => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can save the SSP Narrative.' });
            return;
        }

        if (!controlId) return;

        const newControls = controls.map(c => {
            if (c.id === controlId) {
                // Log the change
                const newLogEntry = {
                    timestamp: new Date().toLocaleString(),
                    user: `${currentRoleConfig.name}: Manual Action`,
                    role: currentRoleConfig.name,
                    action: 'SSP Narrative Edit',
                    detail: `${c.id} implementation narrative manually updated.`,
                };
                setAuditLog(prevLog => [newLogEntry, ...prevLog]); 

                setMessage({ type: 'success', text: `SSP Narrative for ${c.id} saved and logged to audit trail.` });

                return { ...c, procedure: newNarrative }; // Update the procedure field
            }
            return c;
        });
        setControls(newControls);

        // Close the editor after saving
        setOpenControlId('');
        setLocalNarrative({});
    }, [controls, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setControls, setMessage]);

    // CORE FUNCTION 6: Handle manual status change via inline editor
    const handleManualStatusChange = useCallback((newStatus, controlId) => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can manually override control status.' });
            return;
        }

        const idToUpdate = controlId || openControlId;
        if (!idToUpdate) return;

        const newControls = controls.map(c => {
            if (c.id === idToUpdate) {
                // Log the status change
                const newLogEntry = {
                    timestamp: new Date().toLocaleString(),
                    user: `${currentRoleConfig.name}: Manual Action`,
                    role: currentRoleConfig.name,
                    action: 'Control Status Override',
                    detail: `${c.id} status manually changed from ${c.status} to ${newStatus}.`,
                };
                setAuditLog(prevLog => [newLogEntry, ...prevLog]); 

                setMessage({ type: 'success', text: `Status for ${c.id} updated to ${newStatus} and logged to audit trail.` });

                return { ...c, status: newStatus };
            }
            return c;
        });
        setControls(newControls);
    }, [controls, currentRoleConfig.permissions, currentRoleConfig.name, openControlId, setAuditLog, setControls, setMessage]);


    return {
        controls,
        setControls,
        poamList,
        assessments,
        fileName,
        setFileName,
        isProcessing,
        setIsProcessing,
        openControlId,
        setOpenControlId,
        localNarrative,
        setLocalNarrative,
        complianceScore,
        riskPosture,
        total,
        implemented,
        runContinuousMonitoring,
        generatePOAandM,
        handlePoamClosure,
        handleDocumentUpload,
        handleSaveNarrative,
        handleManualStatusChange,
    };
};


