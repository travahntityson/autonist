        complianceScore,
        riskPosture,
        total,
        implemented,
        runContinuousMonitoring,
        generatePOAandM,
        handlePoamClosure,
        handleDocumentUpload,
        handleSaveNarrative,
        handleManualStatusChange,
    } = useRmfAutomation(currentRoleConfig, setAuditLog, setMessage);

    // --- Auxiliary Handlers (CSV Exports, etc.) ---

    // Handle simulated file upload (extracting filename)
    const handleFileChange = useCallback((event) => {
        const file = event.target.files[0];
        if (file) {
            setFileName(file.name);
            setMessage({ type: 'info', text: `File "${file.name}" uploaded. Processing via simulated OCR. Click Analyze to run NLP.` });
        }
    }, [setMessage, setFileName]);

    // Function to export POA&M data to eMASS compatible CSV
    const exportPoamToEmassCsv = useCallback(() => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can export POA&M findings.' });
            return;
        }

        if (poamList.length === 0) {
            setMessage({ type: 'info', text: 'Please generate POA&M entries first before exporting the CSV.' });
            return;
        }

        const headers = [
          "Control ID", "Finding Description", "Corrective Action Plan", "Status", 
          "Responsible Organization", "Scheduled Completion Date (MM/DD/YYYY)", "Severity (High/Moderate/Low)"
        ];

        const rows = poamList.map(item => [
          item.controlId,
          `Deficiency in ${item.finding}`,
          item.remediation.replace(/,/g, ''),
          item.status,
          item.responsibleParty,
          item.dueDate,
          item.severity
        ]);

        const csvContent = [headers.join(","), ...rows.map(row => row.join(","))].join("\n");
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `eMASS_POAandM_Export_${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        URL.revokeObjectURL(url);
        
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRoleConfig.name}: Manual Action`,
            role: currentRoleConfig.name,
            action: 'eMASS POA&M Export',
            detail: `Exported ${poamList.length} POA&M findings to eMASS CSV format.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'success', text: `POA&M data exported successfully as eMASS-compatible CSV.` });
    }, [poamList, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]);

    // Function to export Security Controls data to eMASS compatible CSV
    const exportControlsToEmassCsv = useCallback(() => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can export control data.' });
            return;
        }

        if (controls.length === 0) {
            setMessage({ type: 'info', text: 'No controls loaded to export.' });
            return;
        }

        const headers = [
          "Control Acronym", "Control Information", "Control Implementation Status", "Control Implementation Narrative", 
          "AP Acronym", "CCI", "Date Tested", "Tested By", "Test Results", "Inheritance Status"
        ];
        const dateTested = new Date().toLocaleDateString();

        const rows = controls.map(item => {
            const apAcronym = item.id.includes('(') ? `${item.id.match(/^[A-Z]{2}-\d+/)[0]} E-MOCK` : `${item.id} E-1`;
            const cciId = `CCI-${item.id.replace(/[^A-Z0-9]/g, '')}-MOCK`;
            
            return [
                item.id,
                `Title: ${item.title}`,
                item.status,
                // Ensure narrative is double-quoted for CSV safety (Review Note: Harden CSV export)
                `"${item.procedure.replace(/"/g, '""').replace(/\n/g, ' ')}"`, 
                apAcronym,
                cciId,
                dateTested,
                "Automated Engine / ISSM",
                `Evidence Mapped: ${item.artifacts.join('; ').replace(/"/g, '""')}`,
                item.inheritance
            ];
        });

        const csvContent = [headers.join(","), ...rows.map(row => row.join(","))].join("\n");
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `eMASS_Controls_Export_Aligned_${new Date().toISOString().slice(0, 10)}.csv`;
        link.click();
        URL.revokeObjectURL(url);
        
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRoleConfig.name}: Manual Action`,
            role: currentRoleConfig.name,
            action: 'eMASS Controls Export (Aligned)',
            detail: `Exported ${controls.length} Security Controls to ALIGNED eMASS CSV format.`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'success', text: `Security Control implementation data exported successfully as ALIGNED eMASS-compatible CSV.` });
    }, [controls, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]);

    // Handle eMASS Baseline CSV upload (reads and overwrites control data)
    const handleEmassBaselineUpload = useCallback((event) => {
        if (!currentRoleConfig.permissions.includes('edit_controls')) {
            setMessage({ type: 'error', text: 'Access Denied: Only ISSM/Auditor can upload baseline data.' });
            return;
        }
        const file = event.target.files[0];
        if (!file) return;

        if (!file.name.toLowerCase().endsWith('.csv')) {
            setMessage({ type: 'error', text: 'Invalid file type. Please upload a CSV file compatible with eMASS exports.' });
            return;
        }

        const reader = new FileReader();
        reader.onload = (e) => {
            const text = e.target.result;
            const lines = text.split('\n').filter(line => line.trim() !== '');
            if (lines.length < 2) {
                setMessage({ type: 'error', text: 'CSV is empty or missing data rows.' });
                return;
            }

            // Simplified CSV parsing using regex to split while respecting quotes
            const headers = lines[0].split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(h => h.trim().replace(/"/g, ''));
            
            const controlIdIndex = headers.indexOf('Control Acronym');
            const statusIndex = headers.indexOf('Control Implementation Status');
            const narrativeIndex = headers.indexOf('Control Implementation Narrative');
            const artifactIndex = headers.indexOf('Test Results');
            const inheritanceIndex = headers.indexOf('Inheritance Status');

            if (controlIdIndex === -1 || statusIndex === -1) {
                 setMessage({ type: 'error', text: 'CSV Headers missing. Must contain "Control Acronym" and "Control Implementation Status".' });
                 return;
            }
            
            const importedControls = lines.slice(1).map(line => {
                const values = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(v => v.trim().replace(/"/g, '')); 
                
                const statusRaw = values[statusIndex] || 'Not Implemented';
                const status = statusRaw.includes('Implemented') ? 'Implemented' : 
                               statusRaw.includes('Partial') ? 'Partially Implemented' : 
                               statusRaw.includes('NA') ? 'Not Applicable' : 'Not Implemented';
                
                const inheritance = (inheritanceIndex !== -1 && values[inheritanceIndex].includes('Inherited')) ? 'Inherited' : 'System Specific';

                return {
                    id: values[controlIdIndex],
                    status: status,
                    procedure: (narrativeIndex !== -1 && values[narrativeIndex]) || `Imported SSP narrative from ${file.name}.`,
                    artifacts: (artifactIndex !== -1 && values[artifactIndex]) ? values[artifactIndex].split(';').map(a => a.trim()) : [`Imported from ${file.name}`],
                    inheritance: inheritance
                };
            }).filter(c => c.id);

            let updatedCount = 0;
            const newControlsMap = new Map(controls.map(c => [c.id, c]));

            importedControls.forEach(imported => {
                if (newControlsMap.has(imported.id)) {
                    const existing = newControlsMap.get(imported.id);
                    // Overwrite the mutable fields
                    newControlsMap.set(imported.id, {
                        ...existing,
                        status: imported.status,
                        procedure: imported.procedure,
                        artifacts: imported.artifacts,
                        inheritance: imported.inheritance,
                    });
                    updatedCount++;
                }
            });
            
            setControls(Array.from(newControlsMap.values()));

            const newLogEntry = {
                timestamp: new Date().toLocaleString(),
                user: `${currentRoleConfig.name}: Manual Action`,
                role: currentRoleConfig.name,
                action: 'eMASS Baseline Import',
                detail: `Imported ${updatedCount} controls from external eMASS template: ${file.name}.`,
            };
            setAuditLog(prevLog => [newLogEntry, ...prevLog]);

            setMessage({ type: 'success', text: `Baseline import successful! ${updatedCount} controls have been updated using data from ${file.name}.` });
        };
        reader.readAsText(file);
        event.target.value = null; // Reset file input
    }, [controls, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setControls, setMessage]);

    // Generic Export (OSCAL)
    const handleExport = useCallback((format) => {
        if (!currentRoleConfig.permissions.includes('view_all')) {
            setMessage({ type: 'error', text: 'Access Denied: Role must have view_all permission to export ATO package.' });
            return;
        }

        const exportData = {
            metadata: { timestamp: new Date().toISOString(), atoStatus },
            controls: controls,
            poam: poamList,
            assessments: assessments,
            auditTrail: auditLog,
        };
        
        const dataStr = JSON.stringify(exportData, null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `ATO_Package_${format}_${new Date().getFullYear()}.json`;
        link.click();
        URL.revokeObjectURL(url);
        
        const newLogEntry = {
            timestamp: new Date().toLocaleString(),
            user: `${currentRoleConfig.name}: Manual Action`,
            role: currentRoleConfig.name,
            action: 'ATO Package Export',
            detail: `Exported full ATO package in ${format} format (OSCAL compliant).`,
        };
        setAuditLog(prevLog => [newLogEntry, ...prevLog]);

        setMessage({ type: 'info', text: `Export simulated: ATO package for ${controls.length} controls prepared for ${format} ingestion (OSCAL compliant).` });
    }, [controls, poamList, assessments, auditLog, atoStatus, currentRoleConfig.permissions, currentRoleConfig.name, setAuditLog, setMessage]);


    // Helper function to handle Control Editor Toggling
    const toggleControlEditor = useCallback((controlId) => {
        setOpenControlId(prevId => prevId === controlId ? '' : controlId);
    }, [setOpenControlId]);

    // Function to handle local narrative change
    const handleLocalNarrativeChange = useCallback((controlId, value) => {
        setLocalNarrative(prev => ({ ...prev, [controlId]: value }));
    }, [setLocalNarrative]);

    // Placeholder Views for other tabs
    const RiskRegisterView = () => <div className="p-4 bg-gray-800 rounded-lg text-gray-400">Risk register view coming soon. Populated by High/Moderate POA&M findings. Current High Risk POA&Ms: {poamList.filter(p => p.severity === 'High' && p.status === 'Open').length}</div>;
    const AuditTrailView = () => (
        <div className="bg-gray-800 rounded-lg shadow-2xl overflow-hidden border border-gray-700">
            <h3 className='p-4 text-xl font-semibold text-cyan-400 border-b border-gray-700'>System Audit Trail ({auditLog.length} Events)</h3>
            <div className="max-h-96 overflow-y-auto">
                <table className="min-w-full divide-y divide-gray-700">
                    <thead className="bg-gray-700">
                        <tr>
                            <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Timestamp</th>
                            <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Action</th>
                            <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">User/Role</th>
                            <th className="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Detail</th>
                        </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-700">
                        {auditLog.map((log, index) => (
                            <tr key={index} className="text-sm hover:bg-gray-700">
                                <td className="px-6 py-3 whitespace-nowrap text-gray-400 font-mono">{log.timestamp}</td>
                                <td className="px-6 py-3 whitespace-nowrap text-cyan-400">{log.action}</td>
                                <td className={`px-6 py-3 whitespace-nowrap text-xs font-bold ${ROLES[log.role]?.color || 'text-white'}`}>{log.user}</td>
                                <td className="px-6 py-3 text-gray-300 max-w-lg truncate">{log.detail}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    );


    // --- RENDER LAYOUT ---

    return (
        <div className="min-h-screen p-4 md:p-8 bg-gray-900 text-white font-sans antialiased">
            <style>{`
                .cyber-button {
                    transition: all 0.2s;
                    box-shadow: 0 0 10px rgba(0, 255, 255, 0.5), 0 0 20px rgba(0, 255, 255, 0.2);
                    text-shadow: 0 0 5px rgba(0, 255, 255, 0.8);
                }
                .cyber-button:hover {
                    box-shadow: 0 0 15px rgba(0, 255, 255, 0.8), 0 0 30px rgba(0, 255, 255, 0.5);
                }
                .progress-bar {
                    background: linear-gradient(to right, #00ffff, #008080);
                }
            `}</style>

            <header className="mb-8 border-b border-gray-700 pb-4">
                <div className="flex justify-start items-center">
                    <h1 className="text-3xl font-bold text-cyan-400 tracking-wider">
                        ATO-in-a-Box | <span className="text-white">RMF Automation Platform</span>
                    </h1>
                </div>
                <div className={`mt-2 p-2 inline-block rounded-full text-xs font-semibold border ${currentRoleConfig.color}`}>
                    Current Role: {currentRoleConfig.name} ({currentRole})
                </div>
            </header>
            
            {/* Messaging Area (Toast/Notification replacement) */}
            {message && (
                <div className={`p-4 rounded-lg mb-6 ${message.type === 'error' ? 'bg-red-900/50 text-red-300 border-red-500' : message.type === 'success' ? 'bg-green-900/50 text-green-300 border-green-500' : 'bg-blue-900/50 text-blue-300 border-blue-500'} border`} role="alert">
                    {message.text}
                </div>
            )}

            {/* Tabs Navigation */}
            <div className="border-b border-gray-700 mb-6 flex space-x-4">
                <TabButton id="dashboard" label="RMF Dashboard" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
                <TabButton id="controls" label="Control Review (NIST 800-53)" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
                <TabButton id="poam" label="POA&M Automation" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
                <TabButton id="risk" label="Risk Register" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
                <TabButton id="audit" label="Audit Trail" activeTab={activeTab} setActiveTab={setActiveTab} currentRole={currentRole} />
            </div>

            <div className="space-y-8">
                {activeTab === 'dashboard' && (
                    <DashboardTab 
                        complianceScore={complianceScore}
                        total={total}
                        implemented={implemented}
                        riskPosture={riskPosture}
                        isProcessing={isProcessing}
                        currentRoleConfig={currentRoleConfig}
                        controls={controls}
                        runContinuousMonitoring={runContinuousMonitoring}
                    />
                )}

                {activeTab === 'controls' && (
                    <ControlReviewTab
                        controls={controls}
                        openControlId={openControlId}
                        localNarrative={localNarrative}
                        currentRoleConfig={currentRoleConfig}
                        total={total}
                        isProcessing={isProcessing}
                        fileName={fileName}
                        handleFileChange={handleFileChange}
                        handleDocumentUpload={handleDocumentUpload}
                        handleEmassBaselineUpload={handleEmassBaselineUpload}
                        toggleControlEditor={toggleControlEditor}
                        handleLocalNarrativeChange={handleLocalNarrativeChange}
                        handleSaveNarrative={handleSaveNarrative}
                        handleManualStatusChange={handleManualStatusChange}
                    />
                )}

                {activeTab === 'poam' && (
                    <PoamAutomationTab 
                        poamList={poamList} 
                        currentRoleConfig={currentRoleConfig}
                        generatePOAandM={generatePOAandM}
                        handlePoamClosure={handlePoamClosure}
                        exportControlsToEmassCsv={exportControlsToEmassCsv}
                        exportPoamToEmassCsv={exportPoamToEmassCsv}
                        handleExport={handleExport}
                    />
                )}

                {activeTab === 'risk' && <RiskRegisterView />}
                {activeTab === 'audit' && <AuditTrailView />}
            </div>
        </div>
    );
};
