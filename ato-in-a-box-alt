    // Integration of the Custom Hook (Replaces the bulk of the logic)
    const {
        controls,
        setControls,
        poamList,
        assessments,
        fileName,
        setFileName,
        isProcessing,
        setIsProcessing,
        openControlId,
        setOpenControlId,
