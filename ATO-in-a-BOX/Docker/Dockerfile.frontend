# Docker\Dockerfile.frontend

# --- STAGE 1: Build the React/Vite Application ---
FROM node:20-alpine as builder

# Set the working directory
WORKDIR /app

# Copy package.json and install dependencies
COPY package.json package-lock.json ./
# Use the correct dependency list for your project if separated
# COPY frontend/package.json frontend/package-lock.json ./

RUN npm install

# Copy the rest of the frontend source code
COPY . .
# If your frontend files are in a 'frontend' subdirectory
# COPY frontend/. .

# Build the application
# Use the VITE_API_BASE_URL from the Docker environment
RUN npm run build

# --- STAGE 2: Serve the application using Nginx ---
FROM nginx:alpine

# Copy the custom Nginx configuration file
COPY ./Docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built static assets from the 'builder' stage to the Nginx public folder
# The 'dist' folder is where 'npm run build' outputs the files (configured in vite.config.js)
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose the Nginx port
EXPOSE 80

# The default Nginx CMD will start the server
CMD ["nginx", "-g", "daemon off;"]